//@version=6
indicator("AI Dynamic Liquidity Engine - Core v2.0 - FIXED", overlay=true)

// === INPUTS ===
zoneLookback = input.int(200, "Total Lookback Bars", minval=50)
swingWindow = input.int(10, "Swing Window Size", minval=3)
volumeWeight = input.float(1.5, "Volume Sensitivity", minval=0.1)
testSensitivity = input.int(3, "Test Sensitivity", minval=1)
boxWidth = input.int(20, "Zone Box Width (Bars)", minval=5)

// === SWING DETECTION ===
isSwingHigh = high == ta.highest(high, swingWindow)
isSwingLow = low == ta.lowest(low, swingWindow)

// === ZONE ACCUMULATION ===
var float[] highZones = array.new_float()
var float[] lowZones = array.new_float()
var int[] highTests = array.new_int()
var int[] lowTests = array.new_int()

if isSwingHigh
    array.push(highZones, high)
    array.push(highTests, 0)
if isSwingLow
    array.push(lowZones, low)
    array.push(lowTests, 0)

// === ZONE VALIDATION & TEST COUNTER ===
if array.size(highZones) > 0
    for i = 0 to array.size(highZones)-1
        float level = array.get(highZones, i)
        if math.abs(high - level) / level < 0.005
            array.set(highTests, i, array.get(highTests, i) + 1)

if array.size(lowZones) > 0
    for i = 0 to array.size(lowZones)-1
        float level = array.get(lowZones, i)
        if math.abs(low - level) / level < 0.005
            array.set(lowTests, i, array.get(lowTests, i) + 1)

// === CLEAN OLD ZONES ===
if array.size(highZones) > 20
    array.shift(highZones), array.shift(highTests)
if array.size(lowZones) > 20
    array.shift(lowZones), array.shift(lowTests)

// === DRAW DYNAMIC ZONES ===
if array.size(highZones) > 0
    for i = 0 to array.size(highZones)-1
        if array.get(highTests, i) >= testSensitivity
            box.new(left=bar_index - boxWidth, right=bar_index, top=array.get(highZones,i), bottom=array.get(highZones,i)*0.997, bgcolor=color.new(color.red, 80), border_color=color.red)

if array.size(lowZones) > 0
    for i = 0 to array.size(lowZones)-1
        if array.get(lowTests, i) >= testSensitivity
            box.new(left=bar_index - boxWidth, right=bar_index, top=array.get(lowZones,i)*1.003, bottom=array.get(lowZones,i), bgcolor=color.new(color.lime, 80), border_color=color.lime)

// === Dashboard ===
var table dash = table.new(position.bottom_right, 2, 2, border_width=1)
if bar_index % 5 == 0
    table.cell(dash, 0, 0, "Dynamic Liquidity AI")
    table.cell(dash, 1, 0, "Active")