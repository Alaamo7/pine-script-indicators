//@version=6
indicator("AI Dynamic Liquidity Engine v2.0", overlay=true, max_boxes_count=80)

//====================================================
// AI Dynamic Liquidity Engine v2.0
// Status: Experimental
// Purpose: Dynamic liquidity-zone detector using swing repetition, retest counts, and managed boxes.
//====================================================

//====================
// SETTINGS
//====================
groupCore = "Core Settings"
groupVisual = "Visual Settings"

swingWindow = input.int(10, "Swing Window Size", minval=3, group=groupCore)
testSensitivity = input.int(3, "Minimum Retests", minval=1, group=groupCore)
zoneTolerancePct = input.float(0.5, "Zone Retest Tolerance %", minval=0.05, step=0.05, group=groupCore)
maxZones = input.int(20, "Maximum Stored Zones", minval=5, maxval=40, group=groupCore)
boxWidth = input.int(20, "Zone Box Width", minval=5, maxval=200, group=groupVisual)
showDashboard = input.bool(true, "Show Dashboard", group=groupVisual)
showZones = input.bool(true, "Show Zones", group=groupVisual)

//====================
// ARRAYS
//====================
var float[] highZones = array.new_float()
var float[] lowZones = array.new_float()
var int[] highTests = array.new_int()
var int[] lowTests = array.new_int()
var box[] supplyBoxes = array.new_box()
var box[] demandBoxes = array.new_box()

//====================
// HELPERS
//====================
trimZoneArrays(float[] zones, int[] tests, int maxCount) =>
    while array.size(zones) > maxCount
        array.shift(zones)
        array.shift(tests)

trimBoxArray(box[] boxes, int maxCount) =>
    while array.size(boxes) > maxCount
        oldBox = array.shift(boxes)
        box.delete(oldBox)

addOrUpdateZone(float[] zones, int[] tests, float level, float tolerancePct) =>
    matched = false
    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1
            existing = array.get(zones, i)
            if existing != 0 and math.abs(level - existing) / existing * 100 <= tolerancePct
                array.set(tests, i, array.get(tests, i) + 1)
                matched := true
    if not matched
        array.push(zones, level)
        array.push(tests, 1)

createZoneBox(box[] boxes, float top, float bottom, color bg, color border, int width, int maxCount) =>
    if showZones and barstate.islast
        newBox = box.new(left=bar_index - width, right=bar_index, top=top, bottom=bottom, bgcolor=bg, border_color=border)
        array.push(boxes, newBox)
        trimBoxArray(boxes, maxCount)

//====================
// SWING DETECTION
//====================
isSwingHigh = high == ta.highest(high, swingWindow)
isSwingLow = low == ta.lowest(low, swingWindow)

if isSwingHigh
    addOrUpdateZone(highZones, highTests, high, zoneTolerancePct)

if isSwingLow
    addOrUpdateZone(lowZones, lowTests, low, zoneTolerancePct)

trimZoneArrays(highZones, highTests, maxZones)
trimZoneArrays(lowZones, lowTests, maxZones)

//====================
// DRAW QUALIFIED ZONES
//====================
qualifiedSupply = 0
qualifiedDemand = 0

if array.size(highZones) > 0
    for i = 0 to array.size(highZones) - 1
        level = array.get(highZones, i)
        tests = array.get(highTests, i)
        if tests >= testSensitivity
            qualifiedSupply += 1
            if barstate.islast
                createZoneBox(supplyBoxes, level, level * 0.997, color.new(color.red, 84), color.new(color.red, 20), boxWidth, maxZones)

if array.size(lowZones) > 0
    for i = 0 to array.size(lowZones) - 1
        level = array.get(lowZones, i)
        tests = array.get(lowTests, i)
        if tests >= testSensitivity
            qualifiedDemand += 1
            if barstate.islast
                createZoneBox(demandBoxes, level * 1.003, level, color.new(color.lime, 84), color.new(color.lime, 20), boxWidth, maxZones)

//====================
// DASHBOARD
//====================
var table dash = table.new(position.bottom_right, 2, 5, border_width=1)

if showDashboard and barstate.islast
    table.clear(dash, 0, 0)
    table.cell(dash, 0, 0, "AI Liquidity Engine", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 1, 0, "Experimental", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 0, 1, "Supply Zones")
    table.cell(dash, 1, 1, str.tostring(qualifiedSupply))
    table.cell(dash, 0, 2, "Demand Zones")
    table.cell(dash, 1, 2, str.tostring(qualifiedDemand))
    table.cell(dash, 0, 3, "Stored Highs")
    table.cell(dash, 1, 3, str.tostring(array.size(highZones)))
    table.cell(dash, 0, 4, "Stored Lows")
    table.cell(dash, 1, 4, str.tostring(array.size(lowZones)))

//====================
// ALERTS
//====================
supplyActive = qualifiedSupply > 0
demandActive = qualifiedDemand > 0
alertcondition(supplyActive, title="AI Liquidity Supply Active", message="AI Dynamic Liquidity Engine: qualified supply zone active on {{ticker}}.")
alertcondition(demandActive, title="AI Liquidity Demand Active", message="AI Dynamic Liquidity Engine: qualified demand zone active on {{ticker}}.")
