//@version=6
indicator("EGX Pro Matrix MTF Filter v1.0", overlay=true, max_labels_count=100)

//====================================================
// EGX Pro Matrix MTF Filter v1.0
// Status: Beta
// Purpose: EGX pivot matrix signals filtered by higher-timeframe EMA trend.
//====================================================

//====================
// SETTINGS
//====================
groupMTF = "Higher Timeframe Filter"
groupLevels = "Matrix Levels"
groupVisual = "Visual Settings"

htfRes = input.timeframe("240", "Higher Timeframe", group=groupMTF)
useMTFFilter = input.bool(true, "Use Higher-Timeframe Filter", group=groupMTF)
htfEmaLen = input.int(50, "HTF EMA Length", minval=1, group=groupMTF)
localEmaLen = input.int(50, "Local EMA Length", minval=1, group=groupLevels)
offset = input.int(10, "Right Label Offset", minval=1, group=groupVisual)
showLabels = input.bool(true, "Show Level Labels", group=groupVisual)
showDashboard = input.bool(true, "Show Dashboard", group=groupVisual)

//====================
// SAFE HIGHER TIMEFRAME LOGIC
//====================
htfClose = request.security(syminfo.tickerid, htfRes, close, barmerge.gaps_off, barmerge.lookahead_off)
htfEma = request.security(syminfo.tickerid, htfRes, ta.ema(close, htfEmaLen), barmerge.gaps_off, barmerge.lookahead_off)

htfTrendBull = not na(htfClose) and not na(htfEma) and htfClose > htfEma
htfTrendBear = not na(htfClose) and not na(htfEma) and htfClose < htfEma

//====================
// DAILY PIVOT MATRIX
//====================
pHigh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
pLow = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_off)
pClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)

hasDailyData = not na(pHigh) and not na(pLow) and not na(pClose)
pivot = hasDailyData ? (pHigh + pLow + pClose) / 3.0 : na
r1 = hasDailyData ? 2.0 * pivot - pLow : na
r2 = hasDailyData ? pivot + (pHigh - pLow) : na
s1 = hasDailyData ? 2.0 * pivot - pHigh : na
s2 = hasDailyData ? pivot - (pHigh - pLow) : na

//====================
// SIGNALS
//====================
emaLocal = ta.ema(close, localEmaLen)
localBuyCondition = not na(pivot) and ta.crossover(close, pivot) and close > emaLocal
localSellCondition = not na(pivot) and ta.crossunder(close, pivot) and close < emaLocal

buySignal = useMTFFilter ? localBuyCondition and htfTrendBull : localBuyCondition
sellSignal = useMTFFilter ? localSellCondition and htfTrendBear : localSellCondition

//====================
// VISUALS
//====================
plot(emaLocal, color=color.new(color.aqua, 0), title="Local EMA")
plotshape(buySignal, title="Confirmed Buy", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="BUY")
plotshape(sellSignal, title="Confirmed Exit", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="EXIT")

var label r2Label = na
var label r1Label = na
var label pivotLabel = na
var label s1Label = na
var label s2Label = na

updateLabel(label existing, float price, string txt, color bg) =>
    label result = existing
    if showLabels and barstate.islast and not na(price)
        if na(result)
            result := label.new(bar_index + offset, price, txt + ": " + str.tostring(price, "#.##"), color=bg, textcolor=color.white, style=label.style_label_left, size=size.small)
        else
            label.set_xy(result, bar_index + offset, price)
            label.set_text(result, txt + ": " + str.tostring(price, "#.##"))
            label.set_color(result, bg)
            label.set_textcolor(result, color.white)
    result

r2Label := updateLabel(r2Label, r2, "Target 2", color.rgb(255, 50, 50))
r1Label := updateLabel(r1Label, r1, "Resistance 1", color.rgb(200, 0, 0))
pivotLabel := updateLabel(pivotLabel, pivot, "Pivot", color.rgb(41, 98, 255))
s1Label := updateLabel(s1Label, s1, "Support 1", color.rgb(0, 150, 136))
s2Label := updateLabel(s2Label, s2, "Stop Area", color.rgb(56, 142, 60))

//====================
// DASHBOARD
//====================
var table dash = table.new(position.top_right, 2, 5, border_width=1, frame_color=color.gray)

if showDashboard and barstate.islast
    table.clear(dash, 0, 0)
    table.cell(dash, 0, 0, "EGX Pro Matrix", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 1, 0, "MTF Filter", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 0, 1, "Current Signal", bgcolor=color.rgb(30, 30, 30), text_color=color.white)
    table.cell(dash, 1, 1, close > pivot ? "Positive" : "Negative", bgcolor=close > pivot ? color.green : color.red, text_color=color.white)
    table.cell(dash, 0, 2, "HTF Trend " + htfRes, bgcolor=color.rgb(30, 30, 30), text_color=color.white)
    table.cell(dash, 1, 2, htfTrendBull ? "Bullish" : htfTrendBear ? "Bearish" : "N/A", bgcolor=htfTrendBull ? color.teal : htfTrendBear ? color.maroon : color.gray, text_color=color.white)
    table.cell(dash, 0, 3, "Decision", bgcolor=color.black, text_color=color.yellow)
    table.cell(dash, 1, 3, buySignal ? "Buy Setup" : sellSignal ? "Exit / Wait" : "Watch", bgcolor=color.black, text_color=color.yellow)
    table.cell(dash, 0, 4, "Pivot", bgcolor=color.rgb(30, 30, 30), text_color=color.white)
    table.cell(dash, 1, 4, not na(pivot) ? str.tostring(pivot, "#.##") : "N/A", bgcolor=color.rgb(30, 30, 30), text_color=color.white)

//====================
// ALERTS
//====================
alertcondition(buySignal, title="EGX Pro Matrix MTF Buy", message="EGX Pro Matrix MTF Filter: buy setup detected on {{ticker}}.")
alertcondition(sellSignal, title="EGX Pro Matrix MTF Exit", message="EGX Pro Matrix MTF Filter: exit setup detected on {{ticker}}.")
