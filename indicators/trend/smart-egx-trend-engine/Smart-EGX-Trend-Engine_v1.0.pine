//@version=6
indicator("Smart EGX Trend Engine", overlay=true)

//=========================
// SETTINGS
//=========================
groupCore = "Core Settings"
showMA = input.bool(true,"Show Moving Averages",group=groupCore)
showDashboard = input.bool(true,"Show Dashboard",group=groupCore)

//=========================
// EGX MOVING AVERAGES
//=========================
ema13  = ta.ema(close,13)
ema30  = ta.ema(close,30)
ema72  = ta.ema(close,72)
ema144 = ta.ema(close,144)
ema288 = ta.ema(close,288)

plot(showMA ? ema13 : na,"EMA13",color=color.orange)
plot(showMA ? ema30 : na,"EMA30",color=color.blue)
plot(showMA ? ema72 : na,"EMA72",color=color.aqua)
plot(showMA ? ema144 : na,"EMA144",color=color.fuchsia)
plot(showMA ? ema288 : na,"EMA288",color=color.gray)

//=========================
// VWAP
//=========================
vwap = ta.vwap
plot(showMA ? vwap : na,"VWAP",color=color.yellow)

//=========================
// MOMENTUM
//=========================
rsi = ta.rsi(close,14)
[plusDI,minusDI,adx] = ta.dmi(14,14)

//=========================
// TREND STATE
//=========================
trend = close > ema13 and close > ema30 ? "Bullish" : close < ema13 and close < ema30 ? "Bearish" : "Sideways"

//=========================
// MULTI TIMEFRAME TREND
//=========================
trend15 = request.security(syminfo.tickerid,"15",close)
trend60 = request.security(syminfo.tickerid,"60",close)
trendD  = request.security(syminfo.tickerid,"D",close)

mtf15 = trend15 > ta.ema(trend15,50) ? "Bull" : "Bear"
mtf60 = trend60 > ta.ema(trend60,50) ? "Bull" : "Bear"
mtfD = trendD > ta.ema(trendD,50) ? "Bull" : "Bear"

//=========================
// TREND SCORE
//=========================
score = 0
score += close > ema30 ? 1 : -1
score += rsi > 50 ? 1 : -1
score += adx > 25 ? 1 : 0

trendScore = score >= 2 ? "Strong Bull" : score <= -2 ? "Strong Bear" : "Neutral"

//=========================
// DASHBOARD
//=========================
var table dash = table.new(position.top_right,2,6,border_width=1)

if showDashboard and barstate.islast
    table.cell(dash,0,0,"Trend")
    table.cell(dash,1,0,trend)
    table.cell(dash,0,1,"Trend Score")
    table.cell(dash,1,1,trendScore)
    table.cell(dash,0,2,"RSI")
    table.cell(dash,1,2,str.tostring(rsi))
    table.cell(dash,0,3,"ADX")
    table.cell(dash,1,3,str.tostring(adx))
    table.cell(dash,0,4,"15m Bias")
    table.cell(dash,1,4,mtf15)
    table.cell(dash,0,5,"1H Bias")
    table.cell(dash,1,5,mtf60)
