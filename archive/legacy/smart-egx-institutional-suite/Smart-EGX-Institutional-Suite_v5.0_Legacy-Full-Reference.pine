//@version=6
indicator("Smart EGX Institutional Suite v5", overlay=true)

//--------------------------------------------------
// MOVING AVERAGES
//--------------------------------------------------
ema13 = ta.ema(close,13)
ema30 = ta.ema(close,30)
ema72 = ta.ema(close,72)
ema144 = ta.ema(close,144)

plot(ema13,color=color.orange,title="EMA 13",linewidth=2)
plot(ema30,color=color.blue,title="EMA 30",linewidth=2)
plot(ema72,color=color.aqua,title="EMA 72",linewidth=2)
plot(ema144,color=color.red,title="EMA 144",linewidth=2)

//--------------------------------------------------
// RSI
//--------------------------------------------------
rsi = ta.rsi(close,14)

//--------------------------------------------------
// ADX
//--------------------------------------------------
[diplus,diminus,adx] = ta.dmi(14,14)

//--------------------------------------------------
// VOLUME ANALYSIS
//--------------------------------------------------
volMA = ta.sma(volume,20)
volumeSpike = volume > volMA * 2
plotshape(volumeSpike, title="Volume Spike", location=location.bottom, color=color.yellow, style=shape.circle, size=size.tiny)

//--------------------------------------------------
// MARKET STRUCTURE
//--------------------------------------------------
ph = ta.pivothigh(high,3,3)
pl = ta.pivotlow(low,3,3)

var float lastHigh = na
var float lastLow = na

if not na(ph)
    lastHigh := ph

if not na(pl)
    lastLow := pl

bosUp = close > lastHigh
bosDown = close < lastLow

plotshape(bosUp, title="BOS Up", location=location.abovebar, color=color.green, style=shape.triangleup)
plotshape(bosDown, title="BOS Down", location=location.belowbar, color=color.red, style=shape.triangledown)

//--------------------------------------------------
// STOP HUNT
//--------------------------------------------------
stopHuntHigh = high > high[1] and close < high[1]
stopHuntLow  = low < low[1] and close > low[1]

plotshape(stopHuntHigh, title="Stop Hunt High", location=location.abovebar, color=color.orange, style=shape.xcross)
plotshape(stopHuntLow, title="Stop Hunt Low", location=location.belowbar, color=color.orange, style=shape.xcross)

//--------------------------------------------------
// ORDER BLOCK
//--------------------------------------------------
bullOB = close[1] < open[1] and close > high[1]
bearOB = close[1] > open[1] and close < low[1]

plotshape(bullOB, title="Bullish OB", location=location.belowbar, color=color.lime, style=shape.square)
plotshape(bearOB, title="Bearish OB", location=location.abovebar, color=color.maroon, style=shape.square)

//--------------------------------------------------
// TREND
//--------------------------------------------------
trend = "Sideways"
if close > ema13 and close > ema30
    trend := "Bullish"
if close < ema13 and close < ema30
    trend := "Bearish"

//--------------------------------------------------
// SCORE
//--------------------------------------------------
score = 0
if close > ema30
    score += 1
if rsi > 50
    score += 1
if adx > 25
    score += 1
if volumeSpike
    score += 1

scoreText = "Weak"
if score >= 3
    scoreText := "Strong"

//--------------------------------------------------
// COLORS
//--------------------------------------------------
trendColor = trend == "Bullish" ? color.new(color.green,0) : trend == "Bearish" ? color.new(color.red,0) : color.new(color.gray,0)
rsiColor = rsi > 70 ? color.red : rsi < 30 ? color.green : color.gray
adxColor = adx > 25 ? color.green : color.gray
volColor = volumeSpike ? color.yellow : color.gray

//--------------------------------------------------
// DASHBOARD
//--------------------------------------------------
var table panel = table.new(position.middle_right,2,14,border_width=1)
if barstate.islast
    table.cell(panel,0,0,"SMART EGX v5",bgcolor=color.black,text_color=color.white)
    table.cell(panel,0,1,"Trend")
    table.cell(panel,1,1,trend,bgcolor=trendColor)
    table.cell(panel,0,2,"RSI")
    table.cell(panel,1,2,str.tostring(rsi),bgcolor=rsiColor)
    table.cell(panel,0,3,"ADX")
    table.cell(panel,1,3,str.tostring(adx),bgcolor=adxColor)
    table.cell(panel,0,4,"Volume")
    table.cell(panel,1,4,volumeSpike ? "Spike" : "Normal",bgcolor=volColor)
    table.cell(panel,0,5,"Structure")
    table.cell(panel,1,5,bosUp ? "BOS Up" : bosDown ? "BOS Down" : "—")
    table.cell(panel,0,6,"Stop Hunt")
    table.cell(panel,1,6,stopHuntHigh or stopHuntLow ? "Detected" : "No")
    table.cell(panel,0,7,"Score")
    table.cell(panel,1,7,scoreText)
    table.cell(panel,0,9,"Legend",bgcolor=color.black,text_color=color.white)
    table.cell(panel,0,10,"EMA 13")
    table.cell(panel,1,10,"Fast Trend",bgcolor=color.orange)
    table.cell(panel,0,11,"EMA 30")
    table.cell(panel,1,11,"Short Trend",bgcolor=color.blue)
    table.cell(panel,0,12,"EMA 72")
    table.cell(panel,1,12,"Mid Trend",bgcolor=color.aqua)
    table.cell(panel,0,13,"EMA 144")
    table.cell(panel,1,13,"Institution Trend",bgcolor=color.red)
