//@version=5
indicator("Smart Money Pro v1.0", overlay=true, max_labels_count=500, max_lines_count=500)

//=============== 0. إعدادات العرض ===============
show_liquidity    = input.bool(true, "Show Liquidity Zones")
show_stop_hunt    = input.bool(true, "Show Stop Hunts")
show_order_blocks = input.bool(true, "Show Order Blocks")
show_fvg          = input.bool(true, "Show Fair Value Gaps")
show_structure    = input.bool(true, "Show Market Structure")
show_entry        = input.bool(true, "Show Entry Signals")
show_volume       = input.bool(true, "Show Volume Spikes")
show_stats        = input.bool(true, "Show Entry Stats")

//=============== 1. السيولة (Liquidity Zones) ===============
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)
if show_liquidity
    plotshape(ph, style=shape.triangleup, location=location.abovebar, color=color.blue, size=size.tiny, title="Liquidity High")
        plotshape(pl, style=shape.triangledown, location=location.belowbar, color=color.orange, size=size.tiny, title="Liquidity Low")

        //=============== 2. اصطياد الستوبات (Stop Hunts) ===============
        last_liq_high = ta.valuewhen(ph, high, 0)
        last_liq_low  = ta.valuewhen(pl, low, 0)
        stop_hunt_up  = not na(last_liq_high) and high > last_liq_high and close < last_liq_high
        stop_hunt_dn  = not na(last_liq_low) and low < last_liq_low and close > last_liq_low
        if show_stop_hunt
            plotshape(stop_hunt_up, style=shape.xcross, location=location.abovebar, color=color.red, size=size.small, title="Stop Hunt Up")
                plotshape(stop_hunt_dn, style=shape.xcross, location=location.belowbar, color=color.green, size=size.small, title="Stop Hunt Down")
                    bgcolor(stop_hunt_up ? color.new(color.red, 90) : na, title="Stop Hunt Zone Up")
                        bgcolor(stop_hunt_dn ? color.new(color.green, 90) : na, title="Stop Hunt Zone Down")

                        //=============== 3. الـ Order Blocks ===============
                        is_bull_ob = ta.pivotlow(low, 2, 2) and close[2] < open[2]
                        is_bear_ob = ta.pivothigh(high, 2, 2) and close[2] > open[2]
                        if show_order_blocks
                            if is_bull_ob
                                    box.new(bar_index[2], low[2], bar_index, low[2] + (high[2]-low[2])/2,
                                                    border_color=color.green, bgcolor=color.new(color.green,80), extend=extend.right)
                                                        if is_bear_ob
                                                                box.new(bar_index[2], high[2], bar_index, high[2] - (high[2]-low[2])/2,
                                                                                border_color=color.red, bgcolor=color.new(color.red,80), extend=extend.right)

                                                                                //=============== 4. الفجوات السعريّة (Fair Value Gap - FVG) ===============
                                                                                fvg_up = low[1] > high[2]
                                                                                fvg_dn = high[1] < low[2]
                                                                                if show_fvg
                                                                                    bgcolor(fvg_up ? color.new(color.purple, 90) : na, offset=-1, title="FVG Up")
                                                                                        bgcolor(fvg_dn ? color.new(color.yellow, 90) : na, offset=-1, title="FVG Down")

                                                                                        //=============== 5. الهيكل السعري (Market Structure) ===============
                                                                                        var string structure = ""
                                                                                        is_hh = ph and high > ta.valuewhen(ph, high, 1)
                                                                                        is_hl = pl and low > ta.valuewhen(pl, low, 1)
                                                                                        is_lh = ph and high < ta.valuewhen(ph, high, 1)
                                                                                        is_ll = pl and low < ta.valuewhen(pl, low, 1)
                                                                                        structure := is_hh ? "HH" : is_hl ? "HL" : is_lh ? "LH" : is_ll ? "LL" : structure
                                                                                        if show_structure and (is_hh or is_hl or is_lh or is_ll)
                                                                                            label.new(bar_index, high, structure, color=color.gray, style=label.style_label_down, size=size.tiny, textcolor=color.white)

                                                                                            //=============== 6. إشارات الدخول (Entry Signals) ===============
                                                                                            vol_spike    = volume > ta.sma(volume, 20) * 2
                                                                                            entry_long   = stop_hunt_dn and vol_spike
                                                                                            entry_short  = stop_hunt_up and vol_spike
                                                                                            if show_entry
                                                                                                plotshape(entry_long,  style=shape.labelup,   location=location.belowbar, color=color.lime, title="Entry Long",  text="LONG")
                                                                                                    plotshape(entry_short, style=shape.labeldown, location=location.abovebar, color=color.red,  title="Entry Short", text="SHORT")

                                                                                                    //=============== 7. انفجارات الحجم (Volume Spike) ===============
                                                                                                    if show_volume
                                                                                                        plotshape(vol_spike, style=shape.circle, location=location.bottom, color=color.teal, size=size.tiny, title="Volume Spike")

                                                                                                        //=============== 8. إحصائيات الدخول ===============
                                                                                                        var int long_count  = 0
                                                                                                        var int short_count = 0
                                                                                                        var int bar_track   = 0
                                                                                                        if entry_long and bar_index != bar_track
                                                                                                            long_count += 1
                                                                                                                bar_track := bar_index
                                                                                                                if entry_short and bar_index != bar_track
                                                                                                                    short_count += 1
                                                                                                                        bar_track := bar_index
                                                                                                                        if show_stats
                                                                                                                            var table stats = table.new(position.top_right, 1, 3, border_width=1)
                                                                                                                                if bar_index % 10 == 0
                                                                                                                                        table.cell(stats, 0, 0, "📊 Entry Stats", text_color=color.white, bgcolor=color.black)
                                                                                                                                                table.cell(stats, 0, 1, "✅ Long Entries: " + str.tostring(long_count), text_color=color.lime)
                                                                                                                                                        table.cell(stats, 0, 2, "❌ Short Entries: " + str.tostring(short_count), text_color=color.red)

                                                                                                                                                        //=============== 9. تنبيهات الدخول ===============
                                                                                                                                                        alertcondition(entry_long,  title="Entry Long Alert",  message="🔔 SMC Signal: Potential Long Entry")
                                                                                                                                                        alertcondition(entry_short, title="Entry Short Alert", message="🔔 SMC Signal: Potential Short Entry")