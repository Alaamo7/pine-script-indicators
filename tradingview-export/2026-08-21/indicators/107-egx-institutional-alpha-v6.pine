//@version=6
// @description مؤشر مؤسسي متكامل للبورصة المصرية يجمع بين هيكل السوق، السيولة، ونظام النقاط الذكي
// @author Senior Pine Programmer for Alaa
indicator("EGX Institutional Alpha v6", overlay=true, max_lines_count=500, max_labels_count=500)

//====================================================
// 1. Inputs - تنظيم المدخلات في مجموعات
//====================================================
groupTrend   = "إعدادات الاتجاه (Trend)"
emaFastLen   = input.int(50, "متوسط المدى المتوسط (EMA 50)", minval=1, group=groupTrend)
emaSlowLen   = input.int(200, "متوسط المدى الطويل (EMA 200)", minval=1, group=groupTrend)

groupMomentum = "إعدادات الزخم (Momentum)"
rsiLen       = input.int(14, "فترة RSI", group=groupMomentum)
rsiUpper     = input.int(60, "حد التفاؤل RSI", group=groupMomentum)
rsiLower     = input.int(40, "حد التشاؤم RSI", group=groupMomentum)

groupSMC      = "هيكل السوق (SMC/ICT)"
pivotLen      = input.int(3, "قوة القمم والقيعان (Pivot)", minval=2, group=groupSMC)
showOB        = input.bool(true, "إظهار مناطق الطلب والعرض (Order Blocks)", group=groupSMC)

groupDashboard = "الواجهة والداشبورد"
showDash      = input.bool(true, "إظهار لوحة البيانات", group=groupDashboard)
dashPos       = input.string("Top Right", "موقع اللوحة", options=["Top Right", "Bottom Right", "Top Left"], group=groupDashboard)

//====================================================
// 2. Trend Engine - محرك الاتجاه
//====================================================
ema50  = ta.ema(close, emaFastLen)
ema200 = ta.ema(close, emaSlowLen)

// تحديد الحالة العامة للاتجاه
isBullishTrend = close > ema50 and ema50 > ema200
isBearishTrend = close < ema50 and ema50 < ema200

plot(ema50, "EMA 50", color=color.new(color.blue, 30), linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.red, 10), linewidth=3)

//====================================================
// 3. Technical Indicators - المؤشرات الفنية
//====================================================
rsiValue = ta.rsi(close, rsiLen)
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
macdBullish = macdLine > signalLine
macdBearish = macdLine < signalLine

//====================================================
// 4. Volume & Liquidity - السيولة والحجم
//====================================================
volMA = ta.sma(volume, 20)
isHighVolume = volume > volMA * 1.5 // فوليوم أعلى من المتوسط بـ 50%
obv = ta.obv
obvEma = ta.ema(obv, 10)
liquidityIn = obv > obvEma // تدفق سيولة إيجابي

//====================================================
// 5. SMC Logic - منطق الهيكل السعري
//====================================================
// استخدام Pivot Points بتأكيد لضمان عدم إعادة الرسم
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastHigh = na
var float lastLow  = na
if not na(ph)
    lastHigh := ph
if not na(pl)
    lastLow  := pl

// كسر الهيكل (BOS) - تأكيد إغلاق شمعة لمنع Repainting
bool bosUp   = close > lastHigh and close[1] <= lastHigh
bool bosDown = close < lastLow and close[1] >= lastLow

// تحديد مناطق Order Blocks مبسطة
var box obBox = na
if bosUp and showOB
    obBox := box.new(left=bar_index[pivotLen], top=high[pivotLen], right=bar_index + 10, bottom=low[pivotLen], 
             bgcolor=color.new(color.green, 90), border_color=color.green)
else if bosDown and showOB
    obBox := box.new(left=bar_index[pivotLen], top=high[pivotLen], right=bar_index + 10, bottom=low[pivotLen], 
             bgcolor=color.new(color.red, 90), border_color=color.red)

//====================================================
// 6. Score System - نظام النقاط الذكي لفلترة الإشارات
//====================================================
int score = 0
score += (isBullishTrend ? 1 : isBearishTrend ? -1 : 0)
score += (rsiValue > rsiUpper ? 1 : rsiValue < rsiLower ? -1 : 0)
score += (macdBullish ? 1 : -1)
score += (liquidityIn ? 1 : -1)
score += (bosUp ? 1 : bosDown ? -1 : 0)

//====================================================
// 7. Signal Engine - محرك الإشارات
//====================================================
bool strongBuy  = score >= 4  and close > open // شرط صعود قوي مع فوليوم
bool strongSell = score <= -4 and close < open // شرط هبوط قوي مع فوليوم

plotshape(strongBuy,  "Buy Signal",  shape.triangleup,   location.belowbar, color.green, size=size.small, text="دخول مؤسسي")
plotshape(strongSell, "Sell Signal", shape.triangledown, location.abovebar, color.red,   size=size.small, text="خروج مؤسسي")

//====================================================
// 8. Dashboard - لوحة البيانات الاحترافية
//====================================================
var table dash = table.new(dashPos == "Top Right" ? position.top_right : dashPos == "Bottom Right" ? position.bottom_right : position.top_left, 2, 8, border_width=1, frame_color=color.gray)

if barstate.islast and showDash
    // العناوين
    table.cell(dash, 0, 0, "المؤشر (EGX Pro)", text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 0, "الحالة الحالية",   text_color=color.white, bgcolor=color.black)
    
    // حالة الاتجاه
    table.cell(dash, 0, 1, "الاتجاه العام", text_color=color.white)
    table.cell(dash, 1, 1, isBullishTrend ? "صاعد مؤسسي" : isBearishTrend ? "هابط مؤسسي" : "عرضي / حذر", bgcolor=isBullishTrend ? color.green : isBearishTrend ? color.red : color.gray)
    
    // نقاط القوة (Score)
    table.cell(dash, 0, 2, "تقييم القوة (Score)", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(score), bgcolor=score >= 3 ? color.green : score <= -3 ? color.red : color.orange)
    
    // الزخم RSI
    table.cell(dash, 0, 3, "الزخم (RSI)", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(rsiValue, "#.##"), text_color=rsiValue > 50 ? color.green : color.red)
    
    // الفوليوم والسيولة
    table.cell(dash, 0, 4, "تدفق السيولة", text_color=color.white)
    table.cell(dash, 1, 4, liquidityIn ? "دخول سيولة ≋" : "خروج سيولة ≈", bgcolor=liquidityIn ? color.green : color.red)
    
    // الهيكلية
    table.cell(dash, 0, 5, "هيكل السوق", text_color=color.white)
    table.cell(dash, 1, 5, bosUp ? "اختراق قمة (BOS)" : bosDown ? "كسر قاع (BOS)" : "هيكل مستقر", bgcolor=bosUp ? color.blue : bosDown ? color.maroon : color.gray)

    // نصيحة علاء
    table.cell(dash, 0, 6, "التوصية التقنية", text_color=color.white, bgcolor=color.rgb(54, 58, 69))
    table.cell(dash, 1, 6, score >= 4 ? "تجميع / شراء" : score <= -4 ? "تخفيف / بيع" : "مراقبة وانتظار", text_color=color.white, bgcolor=color.rgb(54, 58, 69))

//====================================================
// 9. Alerts - التنبيهات
//====================================================
alertcondition(strongBuy,  "إشارة شراء قوية - EGX", "دخول مؤسسي مؤكد بنظام النقاط على سهمك")
alertcondition(strongSell, "إشارة بيع قوية - EGX", "خروج مؤسسي مؤكد بنظام النقاط - حذر!")