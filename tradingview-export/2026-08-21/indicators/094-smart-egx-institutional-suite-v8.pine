//@version=6
indicator("Smart EGX Institutional Suite v8", overlay=true, max_boxes_count=500, max_lines_count=500)

// ==========================================
// 1. المتوسطات المتحركة (Moving Averages)
// ==========================================
group_ema = "إعدادات المتوسطات EGX"

ema9   = ta.ema(close, 9)
ema21  = ta.ema(close, 21)
ema50  = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)

plot(ema9, "EMA 9", color=color.aqua, linewidth=1)
plot(ema21, "EMA 21", color=color.blue, linewidth=1)
plot(ema50, "EMA 50", color=color.orange, linewidth=2)
plot(ema200, "EMA 200", color=color.red, linewidth=3)

// ==========================================
// 2. المؤشرات الفنية (RSI + ADX)
// ==========================================
group_tech = "المؤشرات الفنية"

rsi_len = input.int(14, "RSI Length", group=group_tech)
rsi = ta.rsi(close, rsi_len)

[plusDI, minusDI, adx] = ta.dmi(14, 14)

// ==========================================
// 3. تحليل الحجم والسيولة
// ==========================================
vol_ma = ta.sma(volume, 20)
high_volume = volume > vol_ma * 1.5

lookback = 20
prev_high = ta.highest(high[1], lookback)
prev_low  = ta.lowest(low[1], lookback)

bullish_sweep = low < prev_low and close > prev_low
bearish_sweep = high > prev_high and close < prev_high

plotshape(bullish_sweep, title="Bullish Sweep", style=shape.labelup, location=location.belowbar, color=color.lime, text="Sweep")
plotshape(bearish_sweep, title="Bearish Sweep", style=shape.labeldown, location=location.abovebar, color=color.red, text="Sweep")

// ==========================================
// 4. هيكلية السوق (BOS)
// ==========================================
pivot_len = 5

ph = ta.pivothigh(high, pivot_len, pivot_len)
pl = ta.pivotlow(low, pivot_len, pivot_len)

var float last_ph = na
var float last_pl = na

if not na(ph)
    last_ph := ph

if not na(pl)
    last_pl := pl

bos_bull = close > last_ph and close[1] <= last_ph
bos_bear = close < last_pl and close[1] >= last_pl

plotshape(bos_bull, "BOS Bullish", shape.labelup, location.belowbar, color=color.lime, text="BOS", textcolor=color.black, size=size.tiny)
plotshape(bos_bear, "BOS Bearish", shape.labeldown, location.abovebar, color=color.red, text="BOS", textcolor=color.white, size=size.tiny)

// ==========================================
// 5. مناطق المؤسسات (FVG + Order Block)
// ==========================================

// Fair Value Gap
is_fvg_bull = low > high[2]
is_fvg_bear = high < low[2]

if is_fvg_bull
    box.new(bar_index[2], high[2], bar_index, low, bgcolor=color.new(color.lime, 90), border_color=na)

if is_fvg_bear
    box.new(bar_index[2], low[2], bar_index, high, bgcolor=color.new(color.red, 90), border_color=na)

// Order Block
var box bullish_ob = na

if bos_bull and close > open[1]
    bullish_ob := box.new(bar_index[1], high[1], bar_index, low[1], bgcolor=color.new(color.green, 80), border_color=color.green)

// ==========================================
// 6. نظام النقاط الذكي (Score System)
// ==========================================
int score = 0

score += (close > ema200 ? 20 : 0)
score += (rsi < 70 and rsi > 50 ? 15 : 0)
score += (adx > 25 ? 15 : 0)
score += (bullish_sweep ? 25 : 0)
score += (is_fvg_bull ? 25 : 0)

string signal_type =
     score >= 70 ? "دخول قوي"
     : score >= 50 ? "مخاطرة متوسطة"
     : "انتظر"

color signal_color =
     score >= 70 ? color.lime
     : score >= 50 ? color.orange
     : color.red

// ==========================================
// 7. Dashboard + Legend (مدمج)
// ==========================================
showDash = input.bool(true, "Show Dashboard", group="Dashboard Settings")

var table dash = table.new(position.middle_right, 2, 12, border_width=1, frame_color=color.gray)

if barstate.islast and showDash

    // Header
    table.cell(dash, 0, 0, "Smart EGX v8", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 1, 0, "Institutional", bgcolor=color.black, text_color=color.white)

    // Market Trend
    table.cell(dash, 0, 1, "Market Trend", text_color=color.white)
    table.cell(dash, 1, 1, close > ema200 ? "Bullish 🔼" : "Bearish 🔽",
     text_color = close > ema200 ? color.lime : color.red)

    // RSI
    table.cell(dash, 0, 2, "RSI", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(rsi, "#.##"), text_color=color.purple)

    // ADX
    table.cell(dash, 0, 3, "ADX", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(adx, "#.##"), text_color=color.orange)

    // Score
    table.cell(dash, 0, 4, "Score", text_color=color.white)
    table.cell(dash, 1, 4, str.tostring(score) + "/100", bgcolor=signal_color)

    // Signal
    table.cell(dash, 0, 5, "Signal", text_color=color.white)
    table.cell(dash, 1, 5, signal_type, text_color=signal_color)

    // =========================
    // Legend Section
    // =========================
    table.cell(dash, 0, 6, "Legend", bgcolor=color.gray)
    table.cell(dash, 1, 6, "Meaning", bgcolor=color.gray)

    table.cell(dash, 0, 7, "EMA 9", text_color=color.aqua)
    table.cell(dash, 1, 7, "Very Short Trend")

    table.cell(dash, 0, 8, "EMA 21", text_color=color.blue)
    table.cell(dash, 1, 8, "Short Trend")

    table.cell(dash, 0, 9, "EMA 50", text_color=color.orange)
    table.cell(dash, 1, 9, "Medium Trend")

    table.cell(dash, 0, 10, "EMA 200", text_color=color.red)
    table.cell(dash, 1, 10, "Major Market Trend")

    table.cell(dash, 0, 11, "FVG / Sweep", text_color=color.yellow)
    table.cell(dash, 1, 11, "Institutional Liquidity Zones")

// ==========================================
// 8. Alerts
// ==========================================
alertcondition(score >= 70, "Strong Institutional Setup", "High Probability Setup on {{ticker}}")
alertcondition(bullish_sweep or bearish_sweep, "Liquidity Sweep", "Liquidity Grab detected on {{ticker}}")