//@version=6
// آخر تحديث: 17 مايو 2025 - v6.2
indicator("Smart Investor Pro - All-in-One v6.2", overlay=true)

// زر Reset يعيد الإعدادات الافتراضية
reset = input.bool(false, "🔄 إعادة الإعدادات للوضع الافتراضي؟")
default(val) => reset ? val : na

// واجهة التحكم
show_EMA_Short = input.bool(true, "إظهار EMA (مضارب)")
show_VWAP = input.bool(true, "إظهار VWAP")
show_BB = input.bool(true, "إظهار Bollinger Bands")
show_SMA50 = input.bool(true, "إظهار SMA 50")
show_MACD = input.bool(true, "إظهار MACD")
show_EMA100 = input.bool(true, "إظهار EMA 100")
show_Ichimoku = input.bool(true, "إظهار إيشيموكو")
show_EMA200 = input.bool(true, "إظهار EMA 200")
show_RSI = input.bool(true, "إظهار RSI")
show_SD_Zones = input.bool(true, "إظهار مناطق الطلب والعرض")
show_Volume = input.bool(true, "إظهار أحجام التداول")
show_Volume_MA = input.bool(true, "إظهار متوسط حجم التداول")
show_Volume_Spike = input.bool(true, "إظهار تنبيهات حجم غير طبيعي")

// دعم جميع الفواصل الزمنية
isHigherTF = input.bool(false, "تفعيل عرض المؤشر من فاصل زمني أعلى؟")
higherTF = input.timeframe("D", "اختر الفاصل الزمني الأعلى")

// المصدر العام حسب الفاصل الزمني
src = isHigherTF ? request.security(syminfo.tickerid, higherTF, close) : close

//--- المضارب (قصير جداً) ---
ema_short1 = ta.ema(src, 9)
ema_short2 = ta.ema(src, 21)
plot((reset or show_EMA_Short) ? ema_short1 : na, color=color.new(color.aqua, 0), linewidth=1, title="EMA 9 (مضارب)")
plot((reset or show_EMA_Short) ? ema_short2 : na, color=color.new(color.blue, 0), linewidth=1, title="EMA 21 (مضارب)")

// VWAP
vwap = ta.vwap(isHigherTF ? request.security(syminfo.tickerid, higherTF, hlc3) : hlc3)
plot((reset or show_VWAP) ? vwap : na, color=color.new(color.yellow, 0), title="VWAP (مضارب)")

// Bollinger Bands
bb_src = isHigherTF ? request.security(syminfo.tickerid, higherTF, close) : close
basis = ta.sma(bb_src, 20)
dev = 2.0 * ta.stdev(bb_src, 20)
upper_band = basis + dev
lower_band = basis - dev
plot((reset or show_BB) ? basis : na, "BB Basis", color=color.gray)
plot((reset or show_BB) ? upper_band : na, "BB Upper", color=color.gray)
plot((reset or show_BB) ? lower_band : na, "BB Lower", color=color.gray)

//--- المستثمر قصير المدى ---
sma50 = ta.sma(src, 50)
plot((reset or show_SMA50) ? sma50 : na, color=color.new(color.orange, 0), linewidth=2, title="SMA 50 (قصير المدى)")

// MACD
[macdLine, signalLine, histLine] = ta.macd(src, 12, 26, 9)
plot((reset or show_MACD) ? macdLine : na, title="MACD Line (قصير المدى)", color=color.green)
plot((reset or show_MACD) ? signalLine : na, title="Signal Line (قصير المدى)", color=color.red)
plot((reset or show_MACD) ? histLine : na, title="MACD Histogram", style=plot.style_columns, color=color.gray)

//--- المستثمر متوسط المدى ---
ema100 = ta.ema(src, 100)
plot((reset or show_EMA100) ? ema100 : na, color=color.new(color.purple, 0), linewidth=2, title="EMA 100 (متوسط المدى)")

// Ichimoku Cloud
high_src = isHigherTF ? request.security(syminfo.tickerid, higherTF, high) : high
low_src = isHigherTF ? request.security(syminfo.tickerid, higherTF, low) : low
conversionLine = (ta.highest(high_src, 9) + ta.lowest(low_src, 9)) / 2
baseLine = (ta.highest(high_src, 26) + ta.lowest(low_src, 26)) / 2
leadLine1 = (conversionLine + baseLine) / 2
leadLine2 = (ta.highest(high_src, 52) + ta.lowest(low_src, 52)) / 2
plot((reset or show_Ichimoku) ? conversionLine : na, color=color.new(color.green, 50), title="Conversion Line")
plot((reset or show_Ichimoku) ? baseLine : na, color=color.new(color.red, 50), title="Base Line")
p1 = plot((reset or show_Ichimoku) ? leadLine1 : na, offset=26, color=color.new(color.green, 80), title="Lead 1")
p2 = plot((reset or show_Ichimoku) ? leadLine2 : na, offset=26, color=color.new(color.red, 80), title="Lead 2")
fill(p1, p2, color=leadLine1 > leadLine2 ? color.new(color.green, 90) : color.new(color.red, 90))

//--- المستثمر بعيد المدى ---
ema200 = ta.ema(src, 200)
plot((reset or show_EMA200) ? ema200 : na, color=color.new(color.red, 0), linewidth=3, title="EMA 200 (بعيد المدى)")

// RSI
rsi = ta.rsi(src, 14)
rsi_overbought = 70
rsi_oversold = 30
rsiColor = rsi > rsi_overbought ? color.red : rsi < rsi_oversold ? color.green : color.gray
plot((reset or show_RSI) ? rsi : na, "RSI (مضارب)", color=rsiColor)

// مناطق الطلب والعرض
lowestLow = ta.lowest(low, 20)
highestHigh = ta.highest(high, 20)
isDemandZone = low <= lowestLow and close > open
isSupplyZone = high >= highestHigh and close < open
demandLevel = isDemandZone ? low : na
supplyLevel = isSupplyZone ? high : na
plotshape(show_SD_Zones and isDemandZone ? demandLevel : na, style=shape.triangleup, location=location.belowbar, color=color.green, title="منطقة طلب")
plotshape(show_SD_Zones and isSupplyZone ? supplyLevel : na, style=shape.triangledown, location=location.abovebar, color=color.red, title="منطقة عرض")

// أحجام التداول وتحليلها
vol = isHigherTF ? request.security(syminfo.tickerid, higherTF, volume) : volume
vol_ma = ta.sma(vol, 20)
vol_spike = vol > vol_ma * 1.5
vol_weak = vol < vol_ma * 0.5
plot((show_Volume or reset) ? vol : na, title="حجم التداول", style=plot.style_columns, color=color.new(color.gray, 0))
plot((show_Volume_MA or reset) ? vol_ma : na, title="متوسط حجم التداول", color=color.orange, linewidth=1)
plotshape(show_Volume_Spike and vol_spike ? vol : na, title="حجم مرتفع جدًا", location=location.bottom, color=color.green, style=shape.circle, size=size.tiny)
plotshape(show_Volume_Spike and vol_weak ? vol : na, title="حجم منخفض جدًا", location=location.bottom, color=color.red, style=shape.xcross, size=size.tiny)

// تنبيهات واضحة
alertcondition(ta.crossover(ema_short1, ema_short2), title="تقاطع EMA للمضارب (شراء)", message="EMA 9 crossed above EMA 21 (شراء قصير المدى)")
alertcondition(ta.crossunder(ema_short1, ema_short2), title="تقاطع EMA للمضارب (بيع)", message="EMA 9 crossed below EMA 21 (بيع قصير المدى)")
