//@version=6
indicator("Expert EGX Analyst Pro v1.4", overlay=true)

//=============================
// INDICATORS
//=============================

ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema200 = ta.ema(close, 200)

rsi = ta.rsi(close, 14)

// ADX via DMI
[plusDI, minusDI, adx] = ta.dmi(14,14)

// Support / Resistance
highestHigh = ta.highest(high,20)
lowestLow = ta.lowest(low,20)

support = lowestLow
resist = highestHigh

//=============================
// TREND
//=============================

trend =
     close > ema21 and ema21 > ema200 ? "BULLISH" :
     close < ema21 and ema21 < ema200 ? "BEARISH" :
     "SIDEWAYS"

trendColor =
     trend == "BULLISH" ? color.lime :
     trend == "BEARISH" ? color.red :
     color.orange

//=============================
// SIGNALS
//=============================

buySignal = ta.crossover(ema9, ema21)
sellSignal = ta.crossunder(ema9, ema21)

plotshape(buySignal,
     style=shape.triangleup,
     location=location.belowbar,
     color=color.lime,
     size=size.small)

plotshape(sellSignal,
     style=shape.triangledown,
     location=location.abovebar,
     color=color.red,
     size=size.small)

//=============================
// PLOTS
//=============================

plot(ema9,color=color.lime,linewidth=2)
plot(ema21,color=color.blue,linewidth=2)
plot(ema200,color=color.gray,linewidth=2)

plot(resist,color=color.orange,linewidth=2)
plot(support,color=color.aqua,linewidth=2)

//=============================
// VOLUME
//=============================

volAvg = ta.sma(volume,20)

volStatus =
     volume > volAvg*1.5 ? "HIGH" :
     volume < volAvg*0.7 ? "LOW" :
     "NORMAL"

//=============================
// DASHBOARD
//=============================

var table panel = table.new(position.top_right,2,14,
     bgcolor=color.rgb(18,18,30),
     border_width=1)

if barstate.islast

    table.cell(panel,0,0,"SMART EGX PANEL",text_color=color.white,bgcolor=color.black)
    table.cell(panel,1,0,"")

    table.cell(panel,0,1,"PRICE",text_color=color.white)
    table.cell(panel,1,1,str.tostring(close,"#.###"),text_color=color.yellow)

    table.cell(panel,0,2,"TREND",text_color=color.white)
    table.cell(panel,1,2,trend,text_color=trendColor)

    table.cell(panel,0,3,"RSI",text_color=color.white)
    table.cell(panel,1,3,str.tostring(rsi,"#.##"),text_color=color.purple)

    table.cell(panel,0,4,"ADX",text_color=color.white)
    table.cell(panel,1,4,str.tostring(adx,"#.##"),text_color=color.orange)

    table.cell(panel,0,5,"+DI",text_color=color.lime)
    table.cell(panel,1,5,str.tostring(plusDI,"#.##"),text_color=color.lime)

    table.cell(panel,0,6,"-DI",text_color=color.red)
    table.cell(panel,1,6,str.tostring(minusDI,"#.##"),text_color=color.red)

    table.cell(panel,0,7,"VOLUME",text_color=color.white)
    table.cell(panel,1,7,volStatus,text_color=color.white)

    table.cell(panel,0,8,"EMA9",text_color=color.lime)
    table.cell(panel,1,8,str.tostring(ema9,"#.###"),text_color=color.lime)

    table.cell(panel,0,9,"EMA21",text_color=color.blue)
    table.cell(panel,1,9,str.tostring(ema21,"#.###"),text_color=color.blue)

    table.cell(panel,0,10,"EMA200",text_color=color.gray)
    table.cell(panel,1,10,str.tostring(ema200,"#.###"),text_color=color.gray)

    table.cell(panel,0,11,"RESIST",text_color=color.orange)
    table.cell(panel,1,11,str.tostring(resist,"#.###"),text_color=color.orange)

    table.cell(panel,0,12,"SUPPORT",text_color=color.aqua)
    table.cell(panel,1,12,str.tostring(support,"#.###"),text_color=color.aqua)

    table.cell(panel,0,13,"SIGNAL",text_color=color.white)
    table.cell(panel,1,13,
         buySignal ? "BUY" :
         sellSignal ? "SELL" :
         "NONE",
         text_color=color.yellow)