//@version=6
indicator("Smart EGX Institutional Suite v4 Clean Dashboard", overlay=true)

//====================================================
// MOVING AVERAGES
//====================================================

ema13 = ta.ema(close,13)
ema30 = ta.ema(close,30)
ema72 = ta.ema(close,72)
ema144 = ta.ema(close,144)
ema288 = ta.ema(close,288)

plot(ema13,color=color.orange,title="EMA13")
plot(ema30,color=color.blue,title="EMA30")
plot(ema72,color=color.aqua,title="EMA72")
plot(ema144,color=color.fuchsia,title="EMA144")
plot(ema288,color=color.gray,title="EMA288",linewidth=2)

vwapValue = ta.vwap
plot(vwapValue,color=color.yellow,title="VWAP",linewidth=2)

//====================================================
// RSI + ADX
//====================================================

rsi = ta.rsi(close,14)
[diplus,diminus,adx] = ta.dmi(14,14)

//====================================================
// VOLUME
//====================================================

volMA = ta.sma(volume,20)
volSpike = volume > volMA * 2

//====================================================
// TREND
//====================================================

trend = "Sideways"

if close > ema13 and close > ema30
    trend := "Bullish"

if close < ema13 and close < ema30
    trend := "Bearish"

//====================================================
// MARKET STRUCTURE
//====================================================

pivotHigh = ta.pivothigh(high,3,3)
pivotLow = ta.pivotlow(low,3,3)

var float lastHigh = na
var float lastLow = na

if not na(pivotHigh)
    lastHigh := pivotHigh

if not na(pivotLow)
    lastLow := pivotLow

bosUp = close > lastHigh
bosDown = close < lastLow

//====================================================
// STOP HUNT
//====================================================

sweepHigh = high > high[1] and close < high[1]
sweepLow = low < low[1] and close > low[1]

//====================================================
// TRAPS
//====================================================

bearTrap =
 close > open and
 high > high[1] and
 close < high[1]

bullTrap =
 close < open and
 low < low[1] and
 close > low[1]

//====================================================
// SCORE SYSTEM
//====================================================

score = 0

if close > ema30
    score += 1
else
    score -= 1

if rsi > 50
    score += 1
else
    score -= 1

if adx > 25
    score += 1

if volSpike
    score += 1

scoreText = "Avoid"

if score >= 3
    scoreText := "A+"
else if score == 2
    scoreText := "A"
else if score == 1
    scoreText := "B"

//====================================================
// SIGNAL FLAGS
//====================================================

bosSignal = "—"

if bosUp
    bosSignal := "⬆ BOS"

if bosDown
    bosSignal := "⬇ BOS"

sweepSignal = "—"

if sweepHigh
    sweepSignal := "⚠ StopHunt↑"

if sweepLow
    sweepSignal := "⚠ StopHunt↓"

trapSignal = "—"

if bearTrap
    trapSignal := "Bear Trap"

if bullTrap
    trapSignal := "Bull Trap"

volumeSignal = "Normal"

if volSpike
    volumeSignal := "Spike"

//====================================================
// COLOR FUNCTIONS
//====================================================

f_color_trend(t)=>

    col = color.gray

    if t == "Bullish"
        col := color.green
    else if t == "Bearish"
        col := color.red

    color.new(col,0)


f_color_rsi(v)=>

    col = color.gray

    if v >= 70
        col := color.red
    else if v <= 30
        col := color.green

    color.new(col,0)


f_color_adx(v)=>

    col = color.gray

    if v >= 25
        col := color.green

    color.new(col,0)

//====================================================
// DASHBOARD
//====================================================

var table panel = table.new(position.middle_right,2,16,border_width=1)

if barstate.islast

    table.cell(panel,0,0,"SMART EGX v4",bgcolor=color.black,text_color=color.white)

    table.cell(panel,0,1,"Trend")
    table.cell(panel,1,1,trend,bgcolor=f_color_trend(trend))

    table.cell(panel,0,2,"RSI")
    table.cell(panel,1,2,str.tostring(rsi),bgcolor=f_color_rsi(rsi))

    table.cell(panel,0,3,"ADX")
    table.cell(panel,1,3,str.tostring(adx),bgcolor=f_color_adx(adx))

    table.cell(panel,0,4,"Volume")
    table.cell(panel,1,4,volumeSignal)

    table.cell(panel,0,5,"Structure")
    table.cell(panel,1,5,bosSignal)

    table.cell(panel,0,6,"Liquidity")
    table.cell(panel,1,6,sweepSignal)

    table.cell(panel,0,7,"Trap")
    table.cell(panel,1,7,trapSignal)

    table.cell(panel,0,8,"Score")
    table.cell(panel,1,8,scoreText)


//====================================================
// LEGEND
//====================================================

    table.cell(panel,0,9,"Legend",bgcolor=color.black,text_color=color.white)

    table.cell(panel,0,10,"EMA13")
    table.cell(panel,1,10,"Trend Fast",bgcolor=color.orange)

    table.cell(panel,0,11,"EMA30")
    table.cell(panel,1,11,"Trend Mid",bgcolor=color.blue)

    table.cell(panel,0,12,"EMA72")
    table.cell(panel,1,12,"Trend Slow",bgcolor=color.aqua)

    table.cell(panel,0,13,"EMA144")
    table.cell(panel,1,13,"Institution Trend",bgcolor=color.fuchsia)

    table.cell(panel,0,14,"EMA288")
    table.cell(panel,1,14,"Macro Trend",bgcolor=color.gray)

    table.cell(panel,0,15,"VWAP")
    table.cell(panel,1,15,"Institution Price",bgcolor=color.yellow)