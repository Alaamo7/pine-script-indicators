//@version=6
indicator(title="الدعم والمقاومة بحجم التداول (مصر) v1.9", shorttitle="S/R Vol Confirm EG v1.9", overlay=true, precision=2)

// --- الإدخالات (Inputs) ---
string pivotTimeframeOpt = input.string("D", title="الإطار الزمني للنقاط المحورية", options=["D", "W", "M"], tooltip="D: يومي, W: أسبوعي, M: شهري. للتداول اللحظي والقصير، 'D' هو الأنسب.")
int volMALength = input.int(20, title="طول متوسط حجم التداول", minval=1, tooltip="عدد الشموع لحساب متوسط حجم التداول.")
float volSpikeMultiplier = input.float(1.75, title="مُضاعِف طفرة حجم التداول", minval=1.0, step=0.1, tooltip="حجم التداول الحالي يجب أن يكون أكبر من المتوسط مضروبًا في هذه القيمة ليُعتبر طفرة.")
int proximityTicks = input.int(5, title="قُرب التلامس (بالتكات)", minval=1, tooltip="مدى قرب السعر من مستوى الدعم/المقاومة ليُعتبر تلامسًا (عدد التكات/النقاط).")
bool showPivotLines = input.bool(true, title="إظهار خطوط النقاط المحورية")
bool showConfirmations = input.bool(true, title="إظهار تأكيدات الحجم")
int lineWidth = input.int(1, title="سُمك خطوط الدعم/المقاومة", minval=1, maxval=5)

bool showLegendInput = input.bool(true, title="إظهار مفتاح الألوان والخطوط", group="مفتاح الألوان")
string legendPositionInput = input.string(position.bottom_right, "موقع مفتاح الألوان", options = [position.top_right, position.top_left, position.bottom_right, position.bottom_left, position.middle_right, position.middle_left], group="مفتاح الألوان")
color legendBgColor = input.color(color.new(color.black, 60), title="لون خلفية المفتاح", group="مفتاح الألوان")
string legendTextSize = input.string(size.normal, title="حجم نص الوصف في المفتاح", options = [size.tiny, size.small, size.normal, size.large, size.huge], group="مفتاح الألوان")

// --- حساب النقاط المحورية (Pivot Points) ---
prevH = request.security(syminfo.tickerid, pivotTimeframeOpt, high[1], lookahead=barmerge.lookahead_on)
prevL = request.security(syminfo.tickerid, pivotTimeframeOpt, low[1], lookahead=barmerge.lookahead_on)
prevC = request.security(syminfo.tickerid, pivotTimeframeOpt, close[1], lookahead=barmerge.lookahead_on)

var float P  = na
var float S1 = na
var float R1 = na
var float S2 = na
var float R2 = na
var float S3 = na
var float R3 = na

if not na(prevH) and not na(prevL) and not na(prevC)
    P  := (prevH + prevL + prevC) / 3.0
    S1 := (P * 2.0) - prevH
    R1 := (P * 2.0) - prevL
    S2 := P - (prevH - prevL)
    R2 := P + (prevH - prevL)
    S3 := prevL - 2.0 * (prevH - P)
    R3 := prevH + 2.0 * (P - prevL)
else
    // هذا هو التنسيق الصحيح لجملة else الذي يجب أن يكون في الكود لديك
    P  := na
    S1 := na
    R1 := na
    S2 := na
    R2 := na
    S3 := na
    R3 := na

// --- تحليل حجم التداول ---
float avgVolume = ta.sma(volume, volMALength)
bool isVolumeSpike = volume > (avgVolume * volSpikeMultiplier) and not na(avgVolume)

color P_color_legend  = color.blue
color S_color_legend  = color.green
color R_color_legend  = color.red
color Conf_S_color_legend = color.green 
color Conf_R_color_legend = color.red  

// --- رسم خطوط النقاط المحورية ---
plot(showPivotLines ? P : na, "P", color=color.new(P_color_legend, 20), style=plot.style_line, linewidth=lineWidth)
plot(showPivotLines ? S1 : na, "S1", color=color.new(S_color_legend, 20), style=plot.style_line, linewidth=lineWidth)
plot(showPivotLines ? R1 : na, "R1", color=color.new(R_color_legend, 20), style=plot.style_line, linewidth=lineWidth)
plot(showPivotLines ? S2 : na, "S2", color=color.new(S_color_legend, 40), style=plot.style_line, linewidth=lineWidth)
plot(showPivotLines ? R2 : na, "R2", color=color.new(R_color_legend, 40), style=plot.style_line, linewidth=lineWidth)
plot(showPivotLines ? S3 : na, "S3", color=color.new(S_color_legend, 60), style=plot.style_line, linewidth=lineWidth)
plot(showPivotLines ? R3 : na, "R3", color=color.new(R_color_legend, 60), style=plot.style_line, linewidth=lineWidth)

// --- منطق تأكيد الدعم والمقاومة ---
float tickSize = syminfo.mintick
float proximityValue = tickSize * float(proximityTicks)

check_level_confirmation(levelValue, isSupportLevel) =>
    bool touched = false
    bool confirmed = false
    if not na(levelValue)
        if isSupportLevel
            touched := low <= (levelValue + proximityValue) and high >= (levelValue - proximityValue)
            if touched and isVolumeSpike and close > levelValue and close > open
                confirmed := true
        else 
            touched := high >= (levelValue - proximityValue) and low <= (levelValue + proximityValue)
            if touched and isVolumeSpike and close < levelValue and close < open
                confirmed := true
    confirmed

bool s1_confirmed = check_level_confirmation(S1, true)
bool r1_confirmed = check_level_confirmation(R1, false)
bool s2_confirmed = check_level_confirmation(S2, true)
bool r2_confirmed = check_level_confirmation(R2, false)
bool s3_confirmed = check_level_confirmation(S3, true)
bool r3_confirmed = check_level_confirmation(R3, false)
bool p_s_confirmed = check_level_confirmation(P, true)
bool p_r_confirmed = check_level_confirmation(P, false)

// --- رسم إشارات التأكيد ---
plotshape(showConfirmations and s1_confirmed, title="S1 Confirmed", location=location.belowbar, color=color.new(Conf_S_color_legend, 0), style=shape.triangleup, size=size.small, text="S1✓")
plotshape(showConfirmations and r1_confirmed, title="R1 Confirmed", location=location.abovebar, color=color.new(Conf_R_color_legend, 0), style=shape.triangledown, size=size.small, text="R1✓")
plotshape(showConfirmations and s2_confirmed, title="S2 Confirmed", location=location.belowbar, color=color.new(color.lime, 0), style=shape.triangleup, size=size.small, text="S2✓")
plotshape(showConfirmations and r2_confirmed, title="R2 Confirmed", location=location.abovebar, color=color.new(color.maroon, 0), style=shape.triangledown, size=size.small, text="R2✓")
plotshape(showConfirmations and s3_confirmed, title="S3 Confirmed", location=location.belowbar, color=color.new(color.olive, 0), style=shape.triangleup, size=size.tiny, text="S3✓")
plotshape(showConfirmations and r3_confirmed, title="R3 Confirmed", location=location.abovebar, color=color.new(color.purple, 0), style=shape.triangledown, size=size.tiny, text="R3✓")
plotshape(showConfirmations and p_s_confirmed, title="Pivot as Support Confirmed", location=location.belowbar, color=color.new(P_color_legend, 0), style=shape.labelup, size=size.tiny, text="P(S)✓")
plotshape(showConfirmations and p_r_confirmed, title="Pivot as Resistance Confirmed", location=location.abovebar, color=color.new(color.fuchsia, 0), style=shape.labeldown, size=size.tiny, text="P(R)✓")

// --- إنشاء ورسم مفتاح الألوان والخطوط ---
if barstate.islast and showLegendInput
    var table legendTable = table.new(position = legendPositionInput, columns = 2, rows = 8, bgcolor = legendBgColor, border_width = 1)

    table.cell(legendTable, 0, 0, "الرمز/اللون", text_halign = text.align_center, text_color=color.white, bgcolor=color.new(color.black, 30), text_size = legendTextSize)
    table.cell(legendTable, 1, 0, "الوصف", text_halign = text.align_center, text_color=color.white, bgcolor=color.new(color.black, 30), text_size = legendTextSize)

    table.merge_cells(legendTable, 0, 1, 1, 1) 
    table.cell(legendTable, 0, 1, "--- خطوط المستويات ---", text_halign = text.align_center, text_color=color.white, text_size=legendTextSize)

    table.cell(legendTable, 0, 2, "P", text_halign = text.align_center, text_color=color.white, bgcolor = P_color_legend, text_size = legendTextSize)
    table.cell(legendTable, 1, 2, "النقطة المحورية الرئيسية", text_halign = text.align_right, text_color=color.white, text_size=legendTextSize)

    table.cell(legendTable, 0, 3, "S1-S3", text_halign = text.align_center, text_color=color.white, bgcolor = S_color_legend, text_size = legendTextSize)
    table.cell(legendTable, 1, 3, "مستويات الدعم (الأخضر)", text_halign = text.align_right, text_color=color.white, text_size=legendTextSize)

    table.cell(legendTable, 0, 4, "R1-R3", text_halign = text.align_center, text_color=color.white, bgcolor = R_color_legend, text_size = legendTextSize)
    table.cell(legendTable, 1, 4, "مستويات المقاومة (الأحمر)", text_halign = text.align_right, text_color=color.white, text_size=legendTextSize)

    table.merge_cells(legendTable, 0, 5, 1, 5) 
    table.cell(legendTable, 0, 5, "--- إشارات التأكيد ---", text_halign = text.align_center, text_color=color.white, text_size=legendTextSize)

    table.cell(legendTable, 0, 6, "▲ S✓", text_halign = text.align_center, text_color = Conf_S_color_legend, text_size = legendTextSize)
    table.cell(legendTable, 1, 6, "تأكيد الدعم", text_halign = text.align_right, text_color=color.white, text_size=legendTextSize)

    table.cell(legendTable, 0, 7, "▼ R✓", text_halign = text.align_center, text_color = Conf_R_color_legend, text_size = legendTextSize)
    table.cell(legendTable, 1, 7, "تأكيد المقاومة", text_halign = text.align_right, text_color=color.white, text_size=legendTextSize)

// --- تنبيهات (اختياري) ---
// ...