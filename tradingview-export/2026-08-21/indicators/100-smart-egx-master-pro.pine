//@version=6
indicator(title="Smart EGX Master Pro", shorttitle="Smart EGX Pro", overlay=true, max_labels_count=500, max_lines_count=500)

// === 1. المدخلات (Inputs) ===
grpTrend = "الإعدادات العامة"
emaFastLen = input.int(50, title="EMA السريع", group=grpTrend)
emaSlowLen = input.int(200, title="EMA البطيء", group=grpTrend)
scoreThreshold = input.int(5, title="عتبة تأكيد الدخول (Score)", group=grpTrend, minval=1)

grpMTF = "إعدادات الفريم الأكبر (MTF)"
// جعلنا الفريم الافتراضي يومي (D) ليكون فلتر قوي لمتداولي الـ 15 دقيقة والساعة
htfRes = input.timeframe("D", title="الفريم الأكبر", group=grpMTF)

// === 2. محرك الاتجاه (Trend Engine) ===
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

plot(emaFast, color=color.blue, linewidth=2, title="EMA 50")
plot(emaSlow, color=color.red, linewidth=2, title="EMA 200")

// === 3. فلتر الفريم الأكبر الصارم (MTF Hard Filter) ===
// نستخدم barmerge لمنع إعادة الرسم وتأكيد البيانات
htfEmaFast = request.security(syminfo.tickerid, htfRes, ta.ema(close, emaFastLen), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
htfEmaSlow = request.security(syminfo.tickerid, htfRes, ta.ema(close, emaSlowLen), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// الاعتماد على وضع المتوسطات للفريم الأكبر فقط (ترند حقيقي) لمنع الخداع بالذيول
htfBull = htfEmaFast > htfEmaSlow
htfBear = htfEmaFast < htfEmaSlow

// === 4. المؤشرات الفنية (Indicators) ===
rsiVal = ta.rsi(close, 14)
[plusDI, minusDI, adxVal] = ta.dmi(14, 14)
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)

// === 5. السيولة والفوليوم (Volume & Liquidity) ===
volMA = ta.sma(volume, 20)
volSpike = volume > (volMA * 1.5)

// === 6. الهيكل السعري (SMC Logic) ===
pivotLen = 5
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastHigh = na
var float lastLow = na

if not na(ph)
    lastHigh := ph
if not na(pl)
    lastLow := pl

bosUp = not na(lastHigh) and close > lastHigh and close[1] <= lastHigh
bosDown = not na(lastLow) and close < lastLow and close[1] >= lastLow

sweepHigh = not na(lastHigh) and high > lastHigh and close < lastHigh
sweepLow = not na(lastLow) and low < lastLow and close > lastLow

bullOB = close > open and close[1] < open[1] and close > high[1]
bearOB = close < open and close[1] > open[1] and close < low[1]

// === 7. نظام التقييم (Score System) ===
int score = 0
score += (close > emaFast ? 1 : -1)
score += (emaFast > emaSlow ? 1 : -1)
score += (rsiVal > 50 ? 1 : -1)
score += (macdLine > signalLine ? 1 : -1)
score += ((plusDI > minusDI and adxVal > 20) ? 1 : (minusDI > plusDI and adxVal > 20) ? -1 : 0)
score += (volSpike and close > open ? 1 : volSpike and close < open ? -1 : 0)
score += (bullOB or sweepLow or bosUp ? 2 : 0)
score += (bearOB or sweepHigh or bosDown ? -2 : 0)

// إضافة تأثير الفريم الأكبر للتقييم
score += (htfBull ? 2 : htfBear ? -2 : 0)

// === 8. طبقة الإشارات مع حق الفيتو (Hard Filter Visual Layer) ===
// يمنع إشارة الشراء إذا كان الفريم الأكبر هابطاً، ويمنع البيع إذا كان صاعداً
isStrongBuy = (score >= scoreThreshold) and not htfBear
isStrongSell = (score <= -scoreThreshold) and not htfBull

barcolor(isStrongBuy ? color.lime : isStrongSell ? color.red : na)
bgcolor(isStrongBuy ? color.new(color.lime, 90) : isStrongSell ? color.new(color.red, 90) : na)

plotshape(isStrongBuy and not isStrongBuy[1], title="Buy Signal", text="▲", style=shape.labelup, location=location.belowbar, color=color.lime, size=size.small, textcolor=color.black)
plotshape(isStrongSell and not isStrongSell[1], title="Sell Signal", text="▼", style=shape.labeldown, location=location.abovebar, color=color.red, size=size.small, textcolor=color.white)

// === 9. لوحة المعلومات (Dashboard & Legend) ===
var table dash = table.new(position.middle_right, 3, 14, border_width=1, border_color=color.new(color.gray, 50))

if barstate.islast
    // -- ترويسة الجدول --
    table.cell(dash, 0, 0, "التحليل الذكي EGX Pro", bgcolor=color.black, text_color=color.white)
    table.merge_cells(dash, 0, 0, 2, 0)
    
    table.cell(dash, 0, 1, "المؤشر", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(dash, 1, 1, "الحالة", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(dash, 2, 1, "القيمة", bgcolor=color.new(color.gray, 80), text_color=color.white)

    // -- بيانات السوق والـ MTF --
    table.cell(dash, 0, 2, "الاتجاه الأكبر (MTF)", text_color=color.white, bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 2, htfBull ? "صاعد بقوة" : htfBear ? "هابط بقوة" : "عرضي", bgcolor=htfBull ? color.new(color.lime, 70) : htfBear ? color.new(color.red, 70) : color.new(color.silver, 50), text_color=color.black)
    table.cell(dash, 2, 2, htfRes, text_color=color.white, bgcolor=color.new(color.gray, 90))

    table.cell(dash, 0, 3, "الاتجاه الحالي", text_color=color.white, bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 3, emaFast > emaSlow ? "صاعد" : "هابط", bgcolor=emaFast > emaSlow ? color.new(color.lime, 70) : color.new(color.red, 70), text_color=color.black)
    table.cell(dash, 2, 3, "-", text_color=color.white, bgcolor=color.new(color.gray, 90))

    table.cell(dash, 0, 4, "الزخم (RSI)", text_color=color.white, bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 4, rsiVal > 50 ? "إيجابي" : "سلبي", bgcolor=rsiVal > 50 ? color.new(color.lime, 70) : color.new(color.red, 70), text_color=color.black)
    table.cell(dash, 2, 4, str.tostring(rsiVal, "#.##"), text_color=color.white, bgcolor=color.new(color.gray, 90))

    table.cell(dash, 0, 5, "الترند (ADX)", text_color=color.white, bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 5, adxVal > 25 ? "قوي" : "ضعيف", bgcolor=adxVal > 25 ? color.new(color.orange, 50) : color.new(color.gray, 50), text_color=color.black)
    table.cell(dash, 2, 5, str.tostring(adxVal, "#.##"), text_color=color.white, bgcolor=color.new(color.gray, 90))

    table.cell(dash, 0, 6, "الهيكلية", text_color=color.white, bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 6, bosUp ? "اختراق" : bosDown ? "كسر" : "استقرار", text_color=color.black, bgcolor=bosUp ? color.new(color.lime, 70) : bosDown ? color.new(color.red, 70) : color.new(color.silver, 50))
    table.cell(dash, 2, 6, "-", text_color=color.white, bgcolor=color.new(color.gray, 90))

    table.cell(dash, 0, 7, "السيولة", text_color=color.white, bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 7, sweepLow ? "سحب شرائي" : sweepHigh ? "مصيدة بيع" : "طبيعي", text_color=color.black, bgcolor=sweepLow ? color.new(color.lime, 70) : sweepHigh ? color.new(color.red, 70) : color.new(color.silver, 50))
    table.cell(dash, 2, 7, "-", text_color=color.white, bgcolor=color.new(color.gray, 90))

    // -- النتيجة النهائية --
    table.cell(dash, 0, 8, "التقييم (Score)", text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 8, isStrongBuy ? "شراء قوي" : isStrongSell ? "بيع قوي" : "انتظار", bgcolor=isStrongBuy ? color.lime : isStrongSell ? color.red : color.yellow, text_color=color.black)
    table.cell(dash, 2, 8, str.tostring(score), text_color=color.white, bgcolor=color.black)

    // -- الدليل المفتاحي (Legend) --
    table.cell(dash, 0, 9, "دليل المؤشر", bgcolor=color.black, text_color=color.white)
    table.merge_cells(dash, 0, 9, 2, 9)
    
    table.cell(dash, 0, 10, "خط أزرق", text_color=color.blue, bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 10, "EMA 50 (الاتجاه القصير)", text_color=color.white, bgcolor=color.new(color.gray, 90))
    table.merge_cells(dash, 1, 10, 2, 10)

    table.cell(dash, 0, 11, "خط أحمر", text_color=color.red, bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 11, "EMA 200 (الاتجاه الرئيسي)", text_color=color.white, bgcolor=color.new(color.gray, 90))
    table.merge_cells(dash, 1, 11, 2, 11)

    table.cell(dash, 0, 12, "▲", text_color=color.lime, bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 12, "إشارة دخول (شراء قوي)", text_color=color.white, bgcolor=color.new(color.gray, 90))
    table.merge_cells(dash, 1, 12, 2, 12)

    table.cell(dash, 0, 13, "▼", text_color=color.red, bgcolor=color.new(color.gray, 90))
    table.cell(dash, 1, 13, "إشارة خروج (بيع قوي)", text_color=color.white, bgcolor=color.new(color.gray, 90))
    table.merge_cells(dash, 1, 13, 2, 13)