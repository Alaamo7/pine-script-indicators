//@version=6
// الاسم التفصيلي: Smart EGX Analyst Pro v7 - Institutional Hybrid Strategy (Scalp & Swing Edition)
// المبرمج: خبير Pine Script Senior | موجه إلى: علاء
// الهدف: دمج تحليل الاتجاه، السيولة، ومنطق SMC مع دليل تفسيري شامل بالداشبورد
indicator("SEGX AI Pro v7", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200)

//====================================================
// 1) المدخلات (Inputs)
//====================================================
groupCore    = "إعدادات التشغيل"
enableScalp  = input.bool(true, "تفعيل إشارات السكالبينج", group=groupCore)
enableSwing  = input.bool(true, "تفعيل إشارات السوينج", group=groupCore)
barsSession  = input.int(24, "إعدادات الجلسة (EGX)", group=groupCore)

groupVisual  = "تخصيص الواجهة"
mobileMode   = input.bool(false, "وضع الموبايل (تصغير الخط)", group=groupVisual)
dashPos      = input.string("Right", "موقع الداشبورد", options=["Right", "Left"], group=groupVisual)

//====================================================
// 2) محرك الاتجاه - الألوان والخطوط (Trend Engine)
//====================================================
f_len(x) => math.min(math.max(x, 1), 4999)

// تعريف المتوسطات الرئيسية (ألوان ثابتة طبقاً للداشبورد)
ema9   = ta.ema(close, 9)   // سماوي (Aqua)
ema21  = ta.ema(close, 21)  // أزرق (Blue)
ema288 = ta.ema(close, f_len(math.round(288 * barsSession))) // رمادي (Gray)
vwap   = ta.vwap(hlc3)      // أصفر (Yellow)

// الرسم على الشارت
plot(ema9,   "EMA 9 Fast",   color=color.aqua, linewidth=1)
plot(ema21,  "EMA 21 Mid",   color=color.blue, linewidth=1)
plot(ema288, "EMA 288 Long", color=color.gray, linewidth=2)
plot(vwap,   "VWAP Institutional", color=color.yellow, linewidth=2)

//====================================================
// 3) منطق السيولة وهيكل السوق (SMC Logic)
//====================================================
volMA = ta.sma(volume, 20)
isVolSpike = volume > volMA * 1.8 

// كشف الـ Order Blocks (بصمة الميكر)
bullOB = close > open and close[1] < open[1] and close > high[1] and isVolSpike
bearOB = close < open and close[1] > open[1] and close < low[1] and isVolSpike

// رسم الصناديق (Boxes) مع تحديد مدة الامتداد
if bullOB
    box.new(bar_index-1, high[1], bar_index + 15, low[1], bgcolor=color.new(color.lime, 90), border_color=color.lime)
if bearOB
    box.new(bar_index-1, high[1], bar_index + 15, low[1], bgcolor=color.new(color.red, 90), border_color=color.red)

//====================================================
// 4) محرك الإشارات (Signal Engine)
//====================================================
rsi = ta.rsi(close, 7)
// حساب التقاطعات لضمان عدم حدوث Repaint
scalpCross = ta.crossover(ema9, ema21)
swingBreak = ta.crossover(close, ta.highest(high, 10))

scalpBuy = enableScalp and scalpCross and close > vwap and rsi > 50
swingBuy = enableSwing and swingBreak and close > ema288

// إظهار الرموز طبقاً للدليل
plotshape(scalpBuy, "Scalp Buy", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 30), size=size.tiny)
plotshape(swingBuy, "Swing Buy", style=shape.labelup, location=location.belowbar, color=color.lime, text="SWING", textcolor=color.black, size=size.small)

//====================================================
// 5) الداشبورد التفسيري المطور (The Legend Dashboard)
//====================================================
var table dash = table.new(dashPos == "Right" ? position.middle_right : position.middle_left, 3, 11, border_width=1, frame_color=color.gray, bgcolor=color.new(color.black, 15))

t_size = mobileMode ? size.tiny : size.small

if barstate.islast
    // العناوين الرئيسية
    table.cell(dash, 0, 0, "البند / المؤشر", bgcolor=color.blue, text_color=color.white, text_size=t_size)
    table.cell(dash, 1, 0, "القيمة اللحظية", bgcolor=color.blue, text_color=color.white, text_size=t_size)
    table.cell(dash, 2, 0, "تفسير اللون والرمز", bgcolor=color.blue, text_color=color.white, text_size=t_size)
    
    // صفوف البيانات مع دليل الألوان
    // EMA 9
    table.cell(dash, 0, 1, "EMA 9 (Fast)", text_color=color.white, text_size=t_size)
    table.cell(dash, 1, 1, str.tostring(ema9, "#.###"), text_color=color.aqua, text_size=t_size)
    table.cell(dash, 2, 1, "سماوي: اتجاه لحظي", text_color=color.aqua, text_size=t_size)

    // EMA 21
    table.cell(dash, 0, 2, "EMA 21 (Mid)", text_color=color.white, text_size=t_size)
    table.cell(dash, 1, 2, str.tostring(ema21, "#.###"), text_color=color.blue, text_size=t_size)
    table.cell(dash, 2, 2, "أزرق: فلتر زخم", text_color=color.blue, text_size=t_size)

    // EMA 288
    table.cell(dash, 0, 3, "EMA 288 (Long)", text_color=color.white, text_size=t_size)
    table.cell(dash, 1, 3, str.tostring(ema288, "#.###"), text_color=color.gray, text_size=t_size)
    table.cell(dash, 2, 3, "رمادي: مرساة استثمار", text_color=color.gray, text_size=t_size)

    // VWAP
    table.cell(dash, 0, 4, "VWAP", text_color=color.white, text_size=t_size)
    table.cell(dash, 1, 4, str.tostring(vwap, "#.###"), text_color=color.yellow, text_size=t_size)
    table.cell(dash, 2, 4, "أصفر: سيولة مؤسسات", text_color=color.yellow, text_size=t_size)

    // إشارات السكالبينج
    table.cell(dash, 0, 5, "حالة السكالبينج", text_color=color.white, text_size=t_size)
    table.cell(dash, 1, 5, scalpBuy ? "دخول سريع" : "انتظار", text_color=scalpBuy ? color.lime : color.silver, text_size=t_size)
    table.cell(dash, 2, 5, "▲: مثلث أخضر صغير", text_color=color.lime, text_size=t_size)

    // إشارات السوينج
    table.cell(dash, 0, 6, "حالة السوينج", text_color=color.white, text_size=t_size)
    table.cell(dash, 1, 6, close > ema288 ? "إيجابي" : "سلبي", text_color=close > ema288 ? color.lime : color.red, text_size=t_size)
    table.cell(dash, 2, 6, "SWING: ليبل كبير", text_color=color.fuchsia, text_size=t_size)

    // بصمة الميكر
    table.cell(dash, 0, 7, "مناطق الميكر", text_color=color.white, text_size=t_size)
    table.cell(dash, 1, 7, bullOB ? "تجميع سيولة" : (bearOB ? "تصريف سيولة" : "هدوء"), text_color=color.yellow, text_size=t_size)
    table.cell(dash, 2, 7, "صناديق: مناطق طلب/عرض", text_color=color.orange, text_size=t_size)

    // السعر الحالي
    table.cell(dash, 0, 8, "الإغلاق الحالي", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=t_size)
    table.cell(dash, 1, 8, str.tostring(close, "#.###"), bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=t_size)
    table.cell(dash, 2, 8, "سعر التنفيذ اللحظي", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=t_size)

//====================================================
// 6) التنبيهات (Alerts)
//====================================================
alertcondition(scalpBuy, "تنبيه سكالبينج", "فرصة مضاربية سريعة على {{ticker}}")
alertcondition(swingBuy, "تنبيه سوينج", "تأكيد اتجاه استثماري على {{ticker}}")