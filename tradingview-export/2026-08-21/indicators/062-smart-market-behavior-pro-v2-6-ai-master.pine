//@version=6
indicator("Smart Market Behavior Pro – v2.6 AI MASTER", shorttitle="SMB Pro v2.6 AI", overlay=true)

// === استرجاع كود الإعدادات (Decode) ===
settings_input = input.string("11111111111111111111", title="استرجاع كود الإعدادات (20 خانة 0/1)", tooltip="أدخل سلسلة من 20 رقمًا (0 أو 1). مثال: 10110011010110011010")

// دالة مساعدة لتطبيق الإعداد من السلسلة النصية
f_apply_setting(index) =>
    str.length(settings_input) >= index + 1 and str.substring(settings_input, index, index + 1) == "1"

// --- متغيرات التحكم (Boolean Toggles) ---
bool master_toggle        = f_apply_setting(0)
bool show_stats_input     = f_apply_setting(2)
bool stats_toggle         = f_apply_setting(3)
bool show_vwap_input      = f_apply_setting(4)
bool vwap_toggle          = f_apply_setting(5)
bool show_obv_ad_input    = f_apply_setting(6)
bool obv_toggle           = f_apply_setting(7)
bool show_zones_input     = f_apply_setting(16)
bool zones_toggle         = f_apply_setting(17)

// === VWAP ===
float vwap_value = ta.vwap(hlc3)
plot(master_toggle and show_vwap_input and vwap_toggle ? vwap_value : na, title="VWAP", color=color.blue)

// === OBV و A/D ===
float obv = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
float ad = ta.cum((high - low != 0) ? ((close - low) - (high - close)) / (high - low) * volume : 0)
plot(master_toggle and show_obv_ad_input and obv_toggle ? obv : na, title="OBV", color=color.orange, display=display.data_window)
plot(master_toggle and show_obv_ad_input and obv_toggle ? ad : na, title="A/D", color=color.aqua, display=display.data_window)

// === مدخلات مناطق الطلب والعرض ===
int pivotLeftBars = input.int(5, title="أشرطة اليسار للنقاط المحورية", group="مناطق الطلب والعرض", minval=1)
int pivotRightBars = input.int(3, title="أشرطة اليمين للنقاط المحورية", group="مناطق الطلب والعرض", minval=1)
int zoneExtensionBars = input.int(30, title="عدد أشرطة امتداد المنطقة", group="مناطق الطلب والعرض", minval=5)
float atrMultiplierZone = input.float(1.0, title="مضاعف ATR لسمك المنطقة", group="مناطق الطلب والعرض", minval=0.1, step=0.1)
int retestWindow = input.int(5, title="نافذة إعادة اختبار المنطقة (أشرطة)", group="مناطق الطلب والعرض", minval=1)

// === مناطق الطلب والعرض + كسر واختبار ===
var box demandBox = na
var box supplyBox = na
var float demandTop = na
var float demandBottom = na
var float supplyTop = na
var float supplyBottom = na
var bool demandBroken = false
var bool supplyBroken = false

var int demandBreakIndex = na
var int supplyBreakIndex = na

ph_val = ta.pivothigh(high, pivotLeftBars, pivotRightBars)
pl_val = ta.pivotlow(low, pivotLeftBars, pivotRightBars)

if master_toggle and show_zones_input and zones_toggle
    if not na(pl_val)
        if not na(demandBox)
            box.delete(demandBox)
        demandBottom := pl_val - (ta.atr(14)[pivotRightBars] * atrMultiplierZone / 2)
        demandTop    := pl_val + (ta.atr(14)[pivotRightBars] * atrMultiplierZone / 2)
        demandBox := box.new(bar_index[pivotRightBars], demandTop, bar_index[pivotRightBars] + zoneExtensionBars, demandBottom, border_color=color.teal, bgcolor=color.new(color.teal, 85), text="طلب")
        demandBroken := false
    if not na(ph_val)
        if not na(supplyBox)
            box.delete(supplyBox)
        supplyBottom := ph_val - (ta.atr(14)[pivotRightBars] * atrMultiplierZone / 2)
        supplyTop    := ph_val + (ta.atr(14)[pivotRightBars] * atrMultiplierZone / 2)
        supplyBox := box.new(bar_index[pivotRightBars], supplyTop, bar_index[pivotRightBars] + zoneExtensionBars, supplyBottom, border_color=color.maroon, bgcolor=color.new(color.maroon, 85), text="عرض")
        supplyBroken := false

// كسر واختبار المناطق
if not demandBroken and close < demandBottom
    box.set_bgcolor(demandBox, color.new(color.red,75))
    label.new(bar_index, demandBottom, "كسر طلب", color=color.red)
    demandBroken := true

if not supplyBroken and close > supplyTop
    box.set_bgcolor(supplyBox, color.new(color.green,75))
    label.new(bar_index, supplyTop, "كسر عرض", style=label.style_label_down, color=color.green)
    supplyBroken := true

// === إحصائيات النجاح ===
var int demandBreaks = 0
var int supplyBreaks = 0
var int demandRetests = 0
var int supplyRetests = 0

if demandBroken and not demandBroken[1]
    demandBreaks += 1
if supplyBroken and not supplyBroken[1]
    supplyBreaks += 1
successDemand = demandBreaks > 0 ? (demandRetests * 100 / demandBreaks) : na
successSupply = supplyBreaks > 0 ? (supplyRetests * 100 / supplyBreaks) : na

// === ملخص رقمي مع دليل مفتاحي ===
var table legend = table.new(position.top_right, 1, 6, border_width=1, frame_color=color.gray, bgcolor=color.black)
if barstate.islast
    table.cell(legend, 0, 0, "🔑 دليل المؤشر", bgcolor=color.gray, text_color=color.white)
    table.cell(legend, 0, 1, "🔵 VWAP متوسط السعر بالحجم", bgcolor=color.blue, text_color=color.white)
    table.cell(legend, 0, 2, "🟠 OBV تدفقات الحجم", bgcolor=color.orange, text_color=color.white)
    table.cell(legend, 0, 3, "🔷 A/D التجميع والتصريف", bgcolor=color.aqua, text_color=color.black)
    table.cell(legend, 0, 4, "🟢 منطقة الطلب (دعم)", bgcolor=color.teal, text_color=color.white)
    table.cell(legend, 0, 5, "🔴 منطقة العرض (مقاومة)", bgcolor=color.maroon, text_color=color.white)

// === ملخص إحصائي ===
var table statsTable = table.new(position.top_center, 1, 1, border_width=1)
if master_toggle and show_stats_input and stats_toggle and barstate.islast
    statsText = "📊 نجاح الطلب: " + str.tostring(successDemand, "#.##") + "%\n📈 نجاح العرض: " + str.tostring(successSupply, "#.##") + "%"
    table.cell(statsTable, 0, 0, statsText, bgcolor=color.gray, text_color=color.white)
