//@version=6
indicator("Smart EGX Institutional Suite v11 – Multi-Timeframe Pro", overlay=true, max_labels_count=300, max_lines_count=300, max_boxes_count=120)

//==================================================================================================
// SMART EGX INSTITUTIONAL SUITE v11 – MULTI-TIMEFRAME PRO
// Architecture:
// 1) MA
// 2) Indicators
// 3) Volume / Liquidity
//==================================================================================================

//==================================================================================================
// 0) CORE
//==================================================================================================
groupCore = "Core"
showPlots         = input.bool(true,  "Show Core Plots", group=groupCore)
showSignals       = input.bool(true,  "Show Institutional Signals", group=groupCore)
showDashboard     = input.bool(true,  "Show Dashboard", group=groupCore)
showLegend        = input.bool(true,  "Show Legend", group=groupCore)
mobileMode        = input.bool(true,  "Mobile Mode", group=groupCore)
useEgyptSessionMA = input.bool(true,  "Use EGX Session-Adjusted EMA Pack", group=groupCore)
extendZones       = input.int(40,     "Zone Extension Bars", minval=5, maxval=300, group=groupCore)

txtTiny  = mobileMode ? size.tiny  : size.small
txtSmall = mobileMode ? size.small : size.normal

//==================================================================================================
// 1) MA
//==================================================================================================
groupMA = "MA"

// User profile
userType = input.string("Day Trader", "Trader Profile", options=["Scalper", "Day Trader", "Swing Trader", "Investor"], group=groupMA)
useEMA   = input.bool(true, "Use EMA For Profile MAs", group=groupMA)

// EGX bars/session
f_getBarsPerSession() =>
    bars = 1
    if timeframe.isminutes
        if timeframe.multiplier == 1
            bars := 270
        else if timeframe.multiplier == 3
            bars := 90
        else if timeframe.multiplier == 5
            bars := 54
        else if timeframe.multiplier == 10
            bars := 27
        else if timeframe.multiplier == 15
            bars := 18
        else if timeframe.multiplier == 30
            bars := 9
        else if timeframe.multiplier == 45
            bars := 6
        else if timeframe.multiplier == 60
            bars := 5
        else
            bars := 1
    bars

f_len(x) =>
    math.min(math.max(x, 1), 4999)

barsPerSession = f_getBarsPerSession()

// Profile selection
f_profile(_type) =>
    fastLen = _type == "Scalper" ? 5  : _type == "Day Trader" ? 9  : _type == "Swing Trader" ? 20  : 50
    slowLen = _type == "Scalper" ? 21 : _type == "Day Trader" ? 50 : _type == "Swing Trader" ? 100 : 200
    rsiLen  = _type == "Scalper" ? 7  : _type == "Day Trader" ? 14 : _type == "Swing Trader" ? 20  : 30
    rsiOB   = _type == "Scalper" ? 80 : _type == "Day Trader" ? 70 : _type == "Swing Trader" ? 68  : 65
    rsiOS   = _type == "Scalper" ? 20 : _type == "Day Trader" ? 30 : _type == "Swing Trader" ? 32  : 35
    [fastLen, slowLen, rsiLen, rsiOB, rsiOS]

[profileFastLen, profileSlowLen, rsiLen, rsiOB, rsiOS] = f_profile(userType)

// Profile MAs
profileFastMA = useEMA ? ta.ema(close, profileFastLen) : ta.sma(close, profileFastLen)
profileSlowMA = useEMA ? ta.ema(close, profileSlowLen) : ta.sma(close, profileSlowLen)

// EGX Institutional EMA pack
ema13 = ta.ema(close, useEgyptSessionMA ? f_len(math.round(13 * barsPerSession))  : 13)
ema30 = ta.ema(close, useEgyptSessionMA ? f_len(math.round(30 * barsPerSession))  : 30)
ema72 = ta.ema(close, useEgyptSessionMA ? f_len(math.round(72 * barsPerSession))  : 72)
ema144 = ta.ema(close, useEgyptSessionMA ? f_len(math.round(144 * barsPerSession)) : 144)
ema288 = ta.ema(close, useEgyptSessionMA ? f_len(math.round(288 * barsPerSession)) : 288)

vwapValue = ta.vwap(hlc3)

// Trend states
trendBull = profileFastMA > profileSlowMA and close > profileSlowMA
trendBear = profileFastMA < profileSlowMA and close < profileSlowMA

egxBull = ema13 > ema30 and ema30 > ema72
egxBear = ema13 < ema30 and ema30 < ema72

// Plots
plot(showPlots ? profileFastMA : na, "Profile Fast MA", color=color.aqua, linewidth=2)
plot(showPlots ? profileSlowMA : na, "Profile Slow MA", color=color.purple, linewidth=2)
plot(showPlots ? ema13 : na, "EGX EMA 13", color=color.orange, linewidth=2)
plot(showPlots ? ema30 : na, "EGX EMA 30", color=color.blue, linewidth=2)
plot(showPlots ? ema72 : na, "EGX EMA 72", color=color.teal, linewidth=2)
plot(showPlots ? ema144 : na, "EGX EMA 144", color=color.fuchsia, linewidth=2)
plot(showPlots ? ema288 : na, "EGX EMA 288", color=color.gray, linewidth=3)
plot(showPlots ? vwapValue : na, "VWAP", color=color.yellow, linewidth=2)

//==================================================================================================
// 2) INDICATORS
//==================================================================================================
groupInd = "Indicators"

// Momentum
adxLen      = input.int(14, "ADX Length", minval=5, group=groupInd)
adxStrong   = input.float(22.0, "ADX Strong Threshold", minval=5.0, step=0.5, group=groupInd)
macdFast    = input.int(12, "MACD Fast", minval=1, group=groupInd)
macdSlow    = input.int(26, "MACD Slow", minval=2, group=groupInd)
macdSignal  = input.int(9,  "MACD Signal", minval=1, group=groupInd)
bbLen       = input.int(20, "BB Length", minval=5, group=groupInd)
bbMult      = input.float(2.0, "BB Multiplier", minval=0.5, step=0.1, group=groupInd)

// MTF
mtf1 = input.timeframe("15",  "MTF 1", group=groupInd)
mtf2 = input.timeframe("60",  "MTF 2", group=groupInd)
mtf3 = input.timeframe("D",   "MTF 3", group=groupInd)

// Pivot / structure
pivotLen = input.int(3, "Pivot Length", minval=2, maxval=10, group=groupInd)
obATRMult = input.float(1.2, "Order Block Max Height ATR Mult", minval=0.2, step=0.1, group=groupInd)
showFVG = input.bool(true, "Show Fair Value Gaps", group=groupInd)

// Indicator calculations
rsi = ta.rsi(close, rsiLen)
[plusDI, minusDI, adx] = ta.dmi(adxLen, adxLen)
[macdLine, macdSignalLine, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)

bbBasis = ta.sma(close, bbLen)
bbDev   = ta.stdev(close, bbLen) * bbMult
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

// MTF trend engine
f_mtfTrend(tf) =>
    tfClose = request.security(syminfo.tickerid, tf, close, barmerge.gaps_off, barmerge.lookahead_off)
    tfEMA21 = request.security(syminfo.tickerid, tf, ta.ema(close, 21), barmerge.gaps_off, barmerge.lookahead_off)
    tfEMA50 = request.security(syminfo.tickerid, tf, ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
    tfClose > tfEMA21 and tfEMA21 > tfEMA50 ? 1 : tfClose < tfEMA21 and tfEMA21 < tfEMA50 ? -1 : 0

mtfTrend1 = f_mtfTrend(mtf1)
mtfTrend2 = f_mtfTrend(mtf2)
mtfTrend3 = f_mtfTrend(mtf3)

mtfBullCount = (mtfTrend1 == 1 ? 1 : 0) + (mtfTrend2 == 1 ? 1 : 0) + (mtfTrend3 == 1 ? 1 : 0)
mtfBearCount = (mtfTrend1 == -1 ? 1 : 0) + (mtfTrend2 == -1 ? 1 : 0) + (mtfTrend3 == -1 ? 1 : 0)

mtfBiasText =
     mtfBullCount >= 2 ? "Bullish"
   : mtfBearCount >= 2 ? "Bearish"
   : "Mixed"

// Structure pivots
pivotHigh = ta.pivothigh(high, pivotLen, pivotLen)
pivotLow  = ta.pivotlow(low, pivotLen, pivotLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar = na

if not na(pivotHigh)
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - pivotLen

if not na(pivotLow)
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - pivotLen

// BOS / CHOCH
var int structureBias = 0  // 1 bull, -1 bear, 0 neutral

bosUpRaw   = not na(lastSwingHigh) and close > lastSwingHigh
bosDownRaw = not na(lastSwingLow) and close < lastSwingLow

bosUp   = bosUpRaw and close > open
bosDown = bosDownRaw and close < open

chochUp   = structureBias == -1 and bosUp
chochDown = structureBias == 1 and bosDown

if bosUp
    structureBias := 1
if bosDown
    structureBias := -1

// Institutional order blocks
atr = ta.atr(14)
bullImpulse = close > high[1] and close > open and (close - open) > atr * 0.35
bearImpulse = close < low[1] and close < open and (open - close) > atr * 0.35

bullOB = close[1] < open[1] and bullImpulse and (high[1] - low[1]) <= atr[1] * obATRMult
bearOB = close[1] > open[1] and bearImpulse and (high[1] - low[1]) <= atr[1] * obATRMult

var box lastBullOBBox = na
var box lastBearOBBox = na
var float bullOBHigh = na
var float bullOBLow = na
var float bearOBHigh = na
var float bearOBLow = na

if bullOB
    bullOBHigh := high[1]
    bullOBLow := low[1]
    if not na(lastBullOBBox)
        box.delete(lastBullOBBox)
    lastBullOBBox := box.new(bar_index - 1, bullOBHigh, bar_index + extendZones, bullOBLow, border_color=color.lime, bgcolor=color.new(color.lime, 85))

if bearOB
    bearOBHigh := high[1]
    bearOBLow := low[1]
    if not na(lastBearOBBox)
        box.delete(lastBearOBBox)
    lastBearOBBox := box.new(bar_index - 1, bearOBHigh, bar_index + extendZones, bearOBLow, border_color=color.red, bgcolor=color.new(color.red, 85))

if not na(lastBullOBBox)
    box.set_right(lastBullOBBox, bar_index + extendZones)
if not na(lastBearOBBox)
    box.set_right(lastBearOBBox, bar_index + extendZones)

// Fair value gaps
bullFVG = low > high[2]
bearFVG = high < low[2]

if showSignals and showFVG and bullFVG
    box.new(bar_index - 2, low, bar_index, high[2], bgcolor=color.new(color.green, 88), border_color=color.new(color.green, 0))

if showSignals and showFVG and bearFVG
    box.new(bar_index - 2, low[2], bar_index, high, bgcolor=color.new(color.red, 88), border_color=color.new(color.red, 0))

// Signal labels
if showSignals and bosUp
    label.new(bar_index, high, chochUp ? "CHOCH↑" : "BOS↑", style=label.style_label_down, color=chochUp ? color.fuchsia : color.lime, textcolor=color.white, size=txtTiny)

if showSignals and bosDown
    label.new(bar_index, low, chochDown ? "CHOCH↓" : "BOS↓", style=label.style_label_up, color=chochDown ? color.fuchsia : color.red, textcolor=color.white, size=txtTiny)

if showSignals and bullOB
    label.new(bar_index - 1, low[1], "Bull OB", style=label.style_label_up, color=color.green, textcolor=color.white, size=txtTiny)

if showSignals and bearOB
    label.new(bar_index - 1, high[1], "Bear OB", style=label.style_label_down, color=color.red, textcolor=color.white, size=txtTiny)

//==================================================================================================
// 3) VOLUME / LIQUIDITY
//==================================================================================================
groupVL = "Volume / Liquidity"

volLen            = input.int(20, "Volume MA Length", minval=2, group=groupVL)
volSpikeMult      = input.float(1.8, "Volume Spike Multiplier", minval=1.0, step=0.1, group=groupVL)
climaxMult        = input.float(3.0, "Climax Volume Multiplier", minval=1.0, step=0.1, group=groupVL)
wickBodyRatioMin  = input.float(1.6, "Sweep Wick/Body Ratio", minval=0.5, step=0.1, group=groupVL)
liqToleranceATR   = input.float(0.15, "Liquidity Pool ATR Tolerance", minval=0.01, step=0.01, group=groupVL)
minPoolTests      = input.int(2, "Min Liquidity Pool Tests", minval=1, maxval=10, group=groupVL)
requireVolForSweep = input.bool(true, "Require Volume Spike For Sweep", group=groupVL)

// Volume engine
volMA = ta.sma(volume, volLen)
volSpike = volume > volMA * volSpikeMult
climaxVol = volume > volMA * climaxMult

// Candle anatomy
body = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

upperWickBodyRatio = body > 0 ? upperWick / body : 0.0
lowerWickBodyRatio = body > 0 ? lowerWick / body : 0.0

// Liquidity pool detection via repeated pivot clustering
var float[] highPoolPrices = array.new_float()
var int[]   highPoolTests  = array.new_int()
var float[] lowPoolPrices  = array.new_float()
var int[]   lowPoolTests   = array.new_int()

f_addPool(_prices, _tests, newLevel, tol) =>
    found = false
    if array.size(_prices) > 0
        for i = 0 to array.size(_prices) - 1
            oldLevel = array.get(_prices, i)
            if math.abs(oldLevel - newLevel) <= tol
                array.set(_tests, i, array.get(_tests, i) + 1)
                found := true
    if not found
        array.push(_prices, newLevel)
        array.push(_tests, 1)

poolTol = atr * liqToleranceATR

if not na(pivotHigh)
    f_addPool(highPoolPrices, highPoolTests, pivotHigh, poolTol)

if not na(pivotLow)
    f_addPool(lowPoolPrices, lowPoolTests, pivotLow, poolTol)

// Keep arrays bounded
if array.size(highPoolPrices) > 20
    array.shift(highPoolPrices)
    array.shift(highPoolTests)

if array.size(lowPoolPrices) > 20
    array.shift(lowPoolPrices)
    array.shift(lowPoolTests)

// Best active liquidity pool
var float activeHighPool = na
var float activeLowPool = na
var int activeHighTests = 0
var int activeLowTests = 0

activeHighPool := na
activeLowPool := na
activeHighTests := 0
activeLowTests := 0

if array.size(highPoolPrices) > 0
    for i = 0 to array.size(highPoolPrices) - 1
        tests = array.get(highPoolTests, i)
        if tests >= minPoolTests and tests >= activeHighTests
            activeHighTests := tests
            activeHighPool := array.get(highPoolPrices, i)

if array.size(lowPoolPrices) > 0
    for i = 0 to array.size(lowPoolPrices) - 1
        tests = array.get(lowPoolTests, i)
        if tests >= minPoolTests and tests >= activeLowTests
            activeLowTests := tests
            activeLowPool := array.get(lowPoolPrices, i)

// Draw active liquidity zones
var box activeHighPoolBox = na
var box activeLowPoolBox = na

if not na(activeHighPool)
    if na(activeHighPoolBox)
        activeHighPoolBox := box.new(bar_index - 5, activeHighPool + atr * 0.08, bar_index + extendZones, activeHighPool - atr * 0.08, border_color=color.red, bgcolor=color.new(color.red, 88))
    else
        box.set_left(activeHighPoolBox, bar_index - 5)
        box.set_right(activeHighPoolBox, bar_index + extendZones)
        box.set_top(activeHighPoolBox, activeHighPool + atr * 0.08)
        box.set_bottom(activeHighPoolBox, activeHighPool - atr * 0.08)

if not na(activeLowPool)
    if na(activeLowPoolBox)
        activeLowPoolBox := box.new(bar_index - 5, activeLowPool + atr * 0.08, bar_index + extendZones, activeLowPool - atr * 0.08, border_color=color.lime, bgcolor=color.new(color.lime, 88))
    else
        box.set_left(activeLowPoolBox, bar_index - 5)
        box.set_right(activeLowPoolBox, bar_index + extendZones)
        box.set_top(activeLowPoolBox, activeLowPool + atr * 0.08)
        box.set_bottom(activeLowPoolBox, activeLowPool - atr * 0.08)

// Stop hunt / liquidity sweep logic
sweepHigh = not na(activeHighPool) and high > activeHighPool and close < activeHighPool and upperWickBodyRatio >= wickBodyRatioMin and (not requireVolForSweep or volSpike)
sweepLow  = not na(activeLowPool) and low < activeLowPool and close > activeLowPool and lowerWickBodyRatio >= wickBodyRatioMin and (not requireVolForSweep or volSpike)

// Trap logic
bearTrap = volSpike and high > high[1] and close < high[1] and close < open
bullTrap = volSpike and low < low[1] and close > low[1] and close > open

// Volume absorption hints
bullAbsorption = lowerWick > body and close > open and volSpike
bearAbsorption = upperWick > body and close < open and volSpike

if showSignals and sweepHigh
    label.new(bar_index, high, "Stop Hunt High", style=label.style_label_down, color=color.orange, textcolor=color.white, size=txtTiny)

if showSignals and sweepLow
    label.new(bar_index, low, "Stop Hunt Low", style=label.style_label_up, color=color.aqua, textcolor=color.white, size=txtTiny)

if showSignals and bearTrap
    label.new(bar_index, high, "Bear Trap", style=label.style_label_down, color=color.red, textcolor=color.white, size=txtTiny)

if showSignals and bullTrap
    label.new(bar_index, low, "Bull Trap", style=label.style_label_up, color=color.lime, textcolor=color.white, size=txtTiny)

//==================================================================================================
// 4) SCORE SYSTEM
//==================================================================================================
groupScore = "Score System"
enableScore = input.bool(true, "Enable Score System", group=groupScore)
minLongScore = input.int(5, "Minimum Long Score", minval=1, maxval=20, group=groupScore)
minShortScore = input.int(-5, "Minimum Short Score", minval=-20, maxval=-1, group=groupScore)

score = 0

// Trend scoring
score += trendBull ? 2 : trendBear ? -2 : 0
score += egxBull ? 2 : egxBear ? -2 : 0

// MTF scoring
score += mtfBullCount >= 2 ? 2 : 0
score += mtfBearCount >= 2 ? -2 : 0

// Momentum scoring
score += rsi > 55 ? 1 : rsi < 45 ? -1 : 0
score += adx >= adxStrong ? 1 : 0
score += macdLine > macdSignalLine ? 1 : macdLine < macdSignalLine ? -1 : 0

// Structure / liquidity scoring
score += bosUp ? 2 : bosDown ? -2 : 0
score += chochUp ? 1 : chochDown ? -1 : 0
score += sweepLow ? 2 : sweepHigh ? -2 : 0
score += bullTrap ? 1 : bearTrap ? -1 : 0
score += bullAbsorption ? 1 : bearAbsorption ? -1 : 0

// OB interaction bonus
inBullOB = not na(bullOBHigh) and not na(bullOBLow) and close >= bullOBLow and close <= bullOBHigh
inBearOB = not na(bearOBHigh) and not na(bearOBLow) and close >= bearOBLow and close <= bearOBHigh

score += inBullOB ? 1 : 0
score += inBearOB ? -1 : 0

scoreText =
     score >= 8  ? "Institutional Bull A+"
   : score >= 5  ? "Institutional Bull"
   : score <= -8 ? "Institutional Bear A+"
   : score <= -5 ? "Institutional Bear"
   : "Neutral"

// Entry qualifiers
longSetup  = enableScore and score >= minLongScore and mtfBullCount >= 2 and (sweepLow or bosUp or chochUp) and adx >= adxStrong
shortSetup = enableScore and score <= minShortScore and mtfBearCount >= 2 and (sweepHigh or bosDown or chochDown) and adx >= adxStrong

if showSignals and longSetup
    label.new(bar_index, low, "Long Setup", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=txtSmall)

if showSignals and shortSetup
    label.new(bar_index, high, "Short Setup", style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=txtSmall)

//==================================================================================================
// 5) DASHBOARD
//==================================================================================================
var table dash = table.new(position.middle_right, 3, 12, border_width=1)

if showDashboard and barstate.islast
    table.clear(dash, 0, 0)

    table.cell(dash, 0, 0, "Item", text_color=color.white, bgcolor=color.blue, text_size=txtSmall)
    table.cell(dash, 1, 0, "State", text_color=color.white, bgcolor=color.blue, text_size=txtSmall)
    table.cell(dash, 2, 0, "Value", text_color=color.white, bgcolor=color.blue, text_size=txtSmall)

    table.cell(dash, 0, 1, "Profile Trend", text_size=txtTiny)
    table.cell(dash, 1, 1, trendBull ? "Bull" : trendBear ? "Bear" : "Mixed", text_size=txtTiny)
    table.cell(dash, 2, 1, str.tostring(profileFastMA, "#.##") + " / " + str.tostring(profileSlowMA, "#.##"), text_size=txtTiny)

    table.cell(dash, 0, 2, "EGX Trend", text_size=txtTiny)
    table.cell(dash, 1, 2, egxBull ? "Bull" : egxBear ? "Bear" : "Mixed", text_size=txtTiny)
    table.cell(dash, 2, 2, str.tostring(ema13, "#.##") + " / " + str.tostring(ema30, "#.##"), text_size=txtTiny)

    table.cell(dash, 0, 3, "MTF Bias", text_size=txtTiny)
    table.cell(dash, 1, 3, mtfBiasText, text_size=txtTiny)
    table.cell(dash, 2, 3, str.tostring(mtfBullCount) + "B / " + str.tostring(mtfBearCount) + "S", text_size=txtTiny)

    table.cell(dash, 0, 4, "RSI", text_size=txtTiny)
    table.cell(dash, 1, 4, rsi >= rsiOB ? "OB" : rsi <= rsiOS ? "OS" : "Mid", text_size=txtTiny)
    table.cell(dash, 2, 4, str.tostring(rsi, "#.##"), text_size=txtTiny)

    table.cell(dash, 0, 5, "ADX", text_size=txtTiny)
    table.cell(dash, 1, 5, adx >= adxStrong ? "Strong" : "Weak", text_size=txtTiny)
    table.cell(dash, 2, 5, str.tostring(adx, "#.##"), text_size=txtTiny)

    table.cell(dash, 0, 6, "Volume", text_size=txtTiny)
    table.cell(dash, 1, 6, climaxVol ? "Climax" : volSpike ? "Spike" : "Normal", text_size=txtTiny)
    table.cell(dash, 2, 6, str.tostring(volume), text_size=txtTiny)

    table.cell(dash, 0, 7, "Structure", text_size=txtTiny)
    table.cell(dash, 1, 7, bosUp ? "BOS↑" : bosDown ? "BOS↓" : "Idle", text_size=txtTiny)
    table.cell(dash, 2, 7, chochUp ? "CHOCH↑" : chochDown ? "CHOCH↓" : "—", text_size=txtTiny)

    table.cell(dash, 0, 8, "Liquidity", text_size=txtTiny)
    table.cell(dash, 1, 8, sweepLow ? "Sweep Low" : sweepHigh ? "Sweep High" : "Stable", text_size=txtTiny)
    table.cell(dash, 2, 8, str.tostring(activeHighTests) + "H / " + str.tostring(activeLowTests) + "L", text_size=txtTiny)

    table.cell(dash, 0, 9, "Order Block", text_size=txtTiny)
    table.cell(dash, 1, 9, inBullOB ? "Bull Zone" : inBearOB ? "Bear Zone" : "Outside", text_size=txtTiny)
    table.cell(dash, 2, 9, bullOB ? "New Bull OB" : bearOB ? "New Bear OB" : "—", text_size=txtTiny)

    table.cell(dash, 0, 10, "Score", text_size=txtTiny, bgcolor=color.yellow, text_color=color.black)
    table.cell(dash, 1, 10, scoreText, text_size=txtTiny, bgcolor=color.yellow, text_color=color.black)
    table.cell(dash, 2, 10, str.tostring(score), text_size=txtTiny, bgcolor=color.yellow, text_color=color.black)

    table.cell(dash, 0, 11, "Setup", text_size=txtTiny)
    table.cell(dash, 1, 11, longSetup ? "Long" : shortSetup ? "Short" : "None", text_size=txtTiny)
    table.cell(dash, 2, 11, str.tostring(close, "#.##"), text_size=txtTiny)

//==================================================================================================
// 6) LEGEND
//==================================================================================================
var table legend = table.new(position.top_right, 3, 12, border_width=1)

if showLegend and barstate.islast
    table.clear(legend, 0, 0)

    table.cell(legend, 0, 0, "Legend", text_color=color.white, bgcolor=color.black, text_size=txtSmall)
    table.cell(legend, 1, 0, "Color", text_color=color.white, bgcolor=color.black, text_size=txtSmall)
    table.cell(legend, 2, 0, "Meaning", text_color=color.white, bgcolor=color.black, text_size=txtSmall)

    table.cell(legend, 0, 1, "EGX EMA 13", text_color=color.white, text_size=txtTiny)
    table.cell(legend, 1, 1, "Orange", text_color=color.orange, text_size=txtTiny)
    table.cell(legend, 2, 1, "Fast EGX institutional trend", text_size=txtTiny)

