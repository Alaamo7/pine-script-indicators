//@version=6
indicator("Expert EGX Analyst Pro v1.3", overlay=true)

//==============================
// SETTINGS
//==============================

groupEGX = "EGX Pack"

enableEGXPack = input.bool(true, "Enable EGX Moving Average Pack", group=groupEGX)
showPlots     = input.bool(true, "Show EGX Averages", group=groupEGX)

//==============================
// SESSION INFO
//==============================

barsPerSession = 24

//==============================
// EGX MOVING AVERAGES
//==============================

ema13_eg  = ta.ema(close, math.min(math.round(13  * barsPerSession), 4999))
ema30_eg  = ta.ema(close, math.min(math.round(30  * barsPerSession), 4999))
ema72_eg  = ta.ema(close, math.min(math.round(72  * barsPerSession), 4999))
ema144_eg = ta.ema(close, math.min(math.round(144 * barsPerSession), 4999))
ema288_eg = ta.ema(close, math.min(math.round(288 * barsPerSession), 4999))

//==============================
// VWAP
//==============================

vwap_val = ta.vwap

//==============================
// PLOTS (FIXED)
//==============================

plot(showPlots and enableEGXPack ? ema13_eg  : na, "EMA13 EG",  color=color.orange)
plot(showPlots and enableEGXPack ? ema30_eg  : na, "EMA30 EG",  color=color.blue)
plot(showPlots and enableEGXPack ? ema72_eg  : na, "EMA72 EG",  color=color.teal)
plot(showPlots and enableEGXPack ? ema144_eg : na, "EMA144 EG", color=color.fuchsia)
plot(showPlots and enableEGXPack ? ema288_eg : na, "EMA288 EG", color=color.gray, linewidth=2)
plot(showPlots and enableEGXPack ? vwap_val  : na, "VWAP", color=color.yellow, linewidth=2)

//==============================
// RSI
//==============================

rsiLen = input.int(14, "RSI Length")
rsi = ta.rsi(close, rsiLen)

//==============================
// VOLUME
//==============================

volAvg = ta.sma(volume, 20)

volStatus =
     volume > volAvg * 1.5 ? "HIGH"
   : volume < volAvg * 0.7 ? "LOW"
   : "NORMAL"

//==============================
// TREND DETECTION
//==============================

trend =
     close > ema13_eg and close > ema30_eg ? "Bullish"
   : close < ema13_eg and close < ema30_eg ? "Bearish"
   : "Sideways"

//==============================
// DASHBOARD
//==============================

var table dashboard = table.new(position.top_right, 2, 4, border_width=1)

if barstate.islast

    table.cell(dashboard, 0, 0, "Trend")
    table.cell(dashboard, 1, 0, trend)

    table.cell(dashboard, 0, 1, "RSI")
    table.cell(dashboard, 1, 1, str.tostring(rsi, format.mintick))

    table.cell(dashboard, 0, 2, "Volume")
    table.cell(dashboard, 1, 2, volStatus)

    table.cell(dashboard, 0, 3, "Price")
    table.cell(dashboard, 1, 3, str.tostring(close, format.mintick))