//@version=6
indicator("Smart EGX Institutional Suite v4 Clean", overlay=true, max_labels_count=300)

//====================================================
// MOVING AVERAGES
//====================================================

ema13 = ta.ema(close,13)
ema30 = ta.ema(close,30)
ema72 = ta.ema(close,72)
ema144 = ta.ema(close,144)
ema288 = ta.ema(close,288)

plot(ema13,color=color.orange,title="EMA13")
plot(ema30,color=color.blue,title="EMA30")
plot(ema72,color=color.aqua,title="EMA72")
plot(ema144,color=color.fuchsia,title="EMA144")
plot(ema288,color=color.gray,title="EMA288",linewidth=2)

vwapValue = ta.vwap
plot(vwapValue,color=color.yellow,title="VWAP",linewidth=2)

//====================================================
// RSI + ADX
//====================================================

rsi = ta.rsi(close,14)
[diplus,diminus,adx] = ta.dmi(14,14)

//====================================================
// VOLUME
//====================================================

volMA = ta.sma(volume,20)
volSpike = volume > volMA * 2

//====================================================
// TREND
//====================================================

trend =
 close > ema13 and close > ema30 ? "Bullish" :
 close < ema13 and close < ema30 ? "Bearish" :
 "Sideways"

//====================================================
// MARKET STRUCTURE
//====================================================

pivotHigh = ta.pivothigh(high,3,3)
pivotLow = ta.pivotlow(low,3,3)

var float lastHigh = na
var float lastLow = na

if not na(pivotHigh)
    lastHigh := pivotHigh

if not na(pivotLow)
    lastLow := pivotLow

bosUp = close > lastHigh
bosDown = close < lastLow

if bosUp
    label.new(bar_index,high,"BOS ↑",color=color.green,textcolor=color.white)

if bosDown
    label.new(bar_index,low,"BOS ↓",color=color.red,textcolor=color.white)

//====================================================
// STOP HUNT
//====================================================

sweepHigh = high > high[1] and close < high[1]
sweepLow = low < low[1] and close > low[1]

if sweepHigh
    label.new(bar_index,high,"STOP HUNT",color=color.orange)

if sweepLow
    label.new(bar_index,low,"STOP HUNT",color=color.aqua)

//====================================================
// TRAPS
//====================================================

bearTrap =
 close > open and
 high > high[1] and
 close < high[1]

bullTrap =
 close < open and
 low < low[1] and
 close > low[1]

if bearTrap
    label.new(bar_index,high,"Bear Trap",color=color.red)

if bullTrap
    label.new(bar_index,low,"Bull Trap",color=color.green)

//====================================================
// ORDER BLOCK
//====================================================

bullOB =
 close > open and
 close[1] < open[1] and
 close > high[1]

bearOB =
 close < open and
 close[1] > open[1] and
 close < low[1]

if bullOB
    box.new(bar_index-1,open[1],bar_index,low[1],
    bgcolor=color.new(color.green,85),
    border_color=color.green)

if bearOB
    box.new(bar_index-1,high[1],bar_index,open[1],
    bgcolor=color.new(color.red,85),
    border_color=color.red)

//====================================================
// FAIR VALUE GAP
//====================================================

bullFVG = low[1] > high[2]
bearFVG = high[1] < low[2]

if bullFVG
    box.new(bar_index-2,high[2],bar_index,low[1],
    bgcolor=color.new(color.green,90))

if bearFVG
    box.new(bar_index-2,high[1],bar_index,low[2],
    bgcolor=color.new(color.red,90))

//====================================================
// SCORE SYSTEM
//====================================================

score = 0

score += close > ema30 ? 1 : -1
score += rsi > 50 ? 1 : -1
score += adx > 25 ? 1 : 0
score += volSpike ? 1 : 0

scoreText =
 score >= 3 ? "A+" :
 score >= 2 ? "A" :
 score >= 1 ? "B" :
 "Avoid"

//====================================================
// PANEL POSITION
//====================================================

panelPos = position.middle_right

//====================================================
// COLOR FUNCTIONS (FIXED)
//====================================================

f_color_setup(s)=>

    col = color.gray

    if s == "A+"
        col := color.lime
    else if s == "A"
        col := color.green
    else if s == "B"
        col := color.yellow

    color.new(col,0)


f_color_rsi(v)=>

    col = color.gray

    if v >= 70
        col := color.red
    else if v <= 30
        col := color.lime

    color.new(col,0)


f_color_adx(v)=>

    col = color.gray

    if v >= 25
        col := color.lime

    color.new(col,0)

//====================================================
// DASHBOARD
//====================================================

var table panel = table.new(panelPos,2,8,border_width=1)

if barstate.islast

    table.cell(panel,0,0,"SMART EGX v4",text_color=color.white,bgcolor=color.black)

    table.cell(panel,0,1,"Trend")
    table.cell(panel,1,1,trend)

    table.cell(panel,0,2,"RSI")
    table.cell(panel,1,2,str.tostring(rsi),bgcolor=f_color_rsi(rsi))

    table.cell(panel,0,3,"ADX")
    table.cell(panel,1,3,str.tostring(adx),bgcolor=f_color_adx(adx))

    table.cell(panel,0,4,"Volume")
    table.cell(panel,1,4,volSpike ? "Spike" : "Normal")

    table.cell(panel,0,5,"Score")
    table.cell(panel,1,5,scoreText,bgcolor=f_color_setup(scoreText))

    table.cell(panel,0,6,"Legend")
    table.cell(panel,1,6,"BOS / FVG / OB")

    table.cell(panel,0,7,"Signals")
    table.cell(panel,1,7,"Institutional Logic")