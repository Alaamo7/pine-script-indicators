//@version=6
indicator("Smart EGX Institutional Suite v2 (Fixed)", overlay=true, max_labels_count=300, max_boxes_count=200)

//============================
// SETTINGS
//============================
showMA      = input.bool(true,  "Show Moving Averages")
showSignals = input.bool(true,  "Show Smart Signals")
showPanel   = input.bool(true,  "Show Dashboard")

panelPosOpt = input.string("Middle Right","Panel Position",
 options=["Top Right","Middle Right","Bottom Right","Top Left","Bottom Left"])

//============================
// PANEL POSITION FIX (NO TERNARY)
//============================
f_pos(x) =>
    pos = position.middle_right
    if x == "Top Right"
        pos := position.top_right
    else if x == "Middle Right"
        pos := position.middle_right
    else if x == "Bottom Right"
        pos := position.bottom_right
    else if x == "Top Left"
        pos := position.top_left
    else
        pos := position.bottom_left
    pos

panelPos = f_pos(panelPosOpt)

//============================
// MOVING AVERAGES
//============================
ema13  = ta.ema(close,13)
ema30  = ta.ema(close,30)
ema72  = ta.ema(close,72)
ema144 = ta.ema(close,144)
ema288 = ta.ema(close,288)

plot(showMA ? ema13  : na,"EMA13",  color=color.orange)
plot(showMA ? ema30  : na,"EMA30",  color=color.blue)
plot(showMA ? ema72  : na,"EMA72",  color=color.aqua)
plot(showMA ? ema144 : na,"EMA144", color=color.fuchsia)
plot(showMA ? ema288 : na,"EMA288", color=color.gray, linewidth=2)

//============================
// VWAP
//============================
vwapVal = ta.vwap
plot(showMA ? vwapVal : na,"VWAP",color=color.yellow)

//============================
// MOMENTUM
//============================
rsi = ta.rsi(close,14)
[plusDI,minusDI,adx] = ta.dmi(14,14)

//============================
// TREND
//============================
trend =
 close > ema13 and close > ema30 ? "Bullish" :
 close < ema13 and close < ema30 ? "Bearish" :
 "Sideways"

//============================
// MARKET STRUCTURE
//============================
pivotHigh = ta.pivothigh(high,3,3)
pivotLow  = ta.pivotlow(low,3,3)

var float lastHigh = na
var float lastLow  = na

if not na(pivotHigh)
    lastHigh := pivotHigh
if not na(pivotLow)
    lastLow := pivotLow

bosUp   = close > lastHigh
bosDown = close < lastLow

if showSignals and bosUp
    label.new(bar_index,high,"BOS ↑",color=color.green,textcolor=color.white)

if showSignals and bosDown
    label.new(bar_index,low,"BOS ↓",color=color.red,textcolor=color.white)

//============================
// LIQUIDITY SWEEP
//============================
sweepHigh = high > high[1] and close < high[1]
sweepLow  = low  < low[1]  and close > low[1]

if showSignals and sweepHigh
    label.new(bar_index,high,"Sweep",color=color.orange)

if showSignals and sweepLow
    label.new(bar_index,low,"Sweep",color=color.aqua)

//============================
// TRAPS
//============================
bearTrap =
 close > open and
 high > high[1] and
 close < high[1]

bullTrap =
 close < open and
 low < low[1] and
 close > low[1]

if showSignals and bearTrap
    label.new(bar_index,high,"Bear Trap",color=color.red,textcolor=color.white)

if showSignals and bullTrap
    label.new(bar_index,low,"Bull Trap",color=color.green,textcolor=color.white)

//============================
// ORDER BLOCK
//============================
bullOB =
 close > open and
 close[1] < open[1] and
 close > high[1]

bearOB =
 close < open and
 close[1] > open[1] and
 close < low[1]

if showSignals and bullOB
    box.new(bar_index-1,open[1],bar_index,low[1],
    bgcolor=color.new(color.green,85),
    border_color=color.green)

if showSignals and bearOB
    box.new(bar_index-1,high[1],bar_index,open[1],
    bgcolor=color.new(color.red,85),
    border_color=color.red)

//============================
// FAIR VALUE GAP
//============================
bullFVG = low[1] > high[2]
bearFVG = high[1] < low[2]

if showSignals and bullFVG
    box.new(bar_index-2,high[2],bar_index,low[1],
    bgcolor=color.new(color.green,90))

if showSignals and bearFVG
    box.new(bar_index-2,high[1],bar_index,low[2],
    bgcolor=color.new(color.red,90))

//============================
// VOLUME
//============================
volMA    = ta.sma(volume,20)
volSpike = volume > volMA * 2

//============================
// SCORE
//============================
score = 0
score += close > ema30 ? 1 : -1
score += rsi > 50 ? 1 : -1
score += adx > 25 ? 1 : 0
score += volSpike ? 1 : 0

scoreText =
 score >= 3 ? "Strong Bull" :
 score <= -3 ? "Strong Bear" :
 "Neutral"

//============================
// DASHBOARD + LEGEND
//============================
var table panel = table.new(panelPos,2,10,border_width=1)

if showPanel and barstate.islast

    table.cell(panel,0,0,"SMART EGX PANEL",text_color=color.white,bgcolor=color.black)

    table.cell(panel,0,1,"Trend")
    table.cell(panel,1,1,trend)

    table.cell(panel,0,2,"RSI")
    table.cell(panel,1,2,str.tostring(rsi))

    table.cell(panel,0,3,"ADX")
    table.cell(panel,1,3,str.tostring(adx))

    table.cell(panel,0,4,"Volume")
    table.cell(panel,1,4,volSpike ? "Spike" : "Normal")

    table.cell(panel,0,5,"Score")
    table.cell(panel,1,5,scoreText)

    table.cell(panel,0,6,"Legend")

    table.cell(panel,0,7,"BOS")
    table.cell(panel,1,7,"Break Structure")

    table.cell(panel,0,8,"Sweep")
    table.cell(panel,1,8,"Liquidity Grab")

    table.cell(panel,0,9,"OB/FVG")
    table.cell(panel,1,9,"Institution Zones")