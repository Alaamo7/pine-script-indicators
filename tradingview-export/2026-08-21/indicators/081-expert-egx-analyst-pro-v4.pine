//@version=6
indicator("Expert EGX Analyst Pro v4", overlay=true, max_labels_count=200)

//============================
// CORE SETTINGS
//============================
groupCore = "Core"
showMA        = input.bool(true,  "Show Moving Averages", group=groupCore)
showSignals   = input.bool(true,  "Show Signals",         group=groupCore)
showDashboard = input.bool(true,  "Show Dashboard",       group=groupCore)

//============================
// TREND ENGINE
//============================
ema13  = ta.ema(close,13)
ema30  = ta.ema(close,30)
ema72  = ta.ema(close,72)
ema144 = ta.ema(close,144)
ema288 = ta.ema(close,288)

plot(showMA ? ema13  : na, "EMA13",  color=color.orange)
plot(showMA ? ema30  : na, "EMA30",  color=color.blue)
plot(showMA ? ema72  : na, "EMA72",  color=color.aqua)
plot(showMA ? ema144 : na, "EMA144", color=color.fuchsia)
plot(showMA ? ema288 : na, "EMA288", color=color.gray)

vwap = ta.vwap
plot(showMA ? vwap : na,"VWAP",color=color.yellow)

//============================
// MOMENTUM
//============================
rsi = ta.rsi(close,14)
[plusDI, minusDI, adx] = ta.dmi(14,14)

//============================
// TREND STATE
//============================
trend =
 close > ema13 and close > ema30 ? "Bullish" :
 close < ema13 and close < ema30 ? "Bearish" :
 "Sideways"

//============================
// MARKET STRUCTURE
//============================
pivotH = ta.pivothigh(high,3,3)
pivotL = ta.pivotlow(low,3,3)

var float lastHigh = na
var float lastLow  = na

if not na(pivotH)
    lastHigh := pivotH

if not na(pivotL)
    lastLow := pivotL

bosUp   = close > lastHigh
bosDown = close < lastLow

if showSignals and bosUp
    label.new(bar_index,high,"BOS↑",color=color.green,textcolor=color.white)

if showSignals and bosDown
    label.new(bar_index,low,"BOS↓",color=color.red,textcolor=color.white)

//============================
// LIQUIDITY SWEEPS
//============================
sweepHigh = high > high[1] and close < high[1]
sweepLow  = low < low[1] and close > low[1]

if showSignals and sweepHigh
    label.new(bar_index,high,"Sweep",color=color.orange)

if showSignals and sweepLow
    label.new(bar_index,low,"Sweep",color=color.aqua)

//============================
// ORDER BLOCK DETECTOR
//============================
bullOB =
 close > open and
 close[1] < open[1] and
 close > high[1]

bearOB =
 close < open and
 close[1] > open[1] and
 close < low[1]

if showSignals and bullOB
    label.new(bar_index,low,"Bull OB",color=color.green,textcolor=color.white)

if showSignals and bearOB
    label.new(bar_index,high,"Bear OB",color=color.red,textcolor=color.white)

//============================
// VOLUME ENGINE
//============================
volMA = ta.sma(volume,20)

volSpike  = volume > volMA * 1.8
climaxVol = volume > volMA * 3

if showSignals and climaxVol
    label.new(bar_index,high,"Climax Vol",color=color.yellow)

//============================
// MTF TREND
//============================
htfClose = request.security(syminfo.tickerid,"60",close)

htfTrend =
 htfClose > ta.ema(htfClose,50) ? "Bull" : "Bear"

//============================
// SCORE SYSTEM
//============================
score = 0

score += trend == "Bullish" ? 2 : trend == "Bearish" ? -2 : 0
score += rsi > 50 ? 1 : -1
score += adx > 25 ? 1 : 0
score += volSpike ? 1 : 0

scoreText =
 score >= 3 ? "Bullish" :
 score <= -3 ? "Bearish" :
 "Neutral"

//============================
// DASHBOARD
//============================
var table dash = table.new(position.top_right,2,6,border_width=1)

if showDashboard and barstate.islast

    table.cell(dash,0,0,"Trend")
    table.cell(dash,1,0,trend)

    table.cell(dash,0,1,"HTF")
    table.cell(dash,1,1,htfTrend)

    table.cell(dash,0,2,"RSI")
    table.cell(dash,1,2,str.tostring(rsi))

    table.cell(dash,0,3,"ADX")
    table.cell(dash,1,3,str.tostring(adx))

    table.cell(dash,0,4,"Score")
    table.cell(dash,1,4,scoreText)

    table.cell(dash,0,5,"Volume")
    table.cell(dash,1,5,volSpike ? "Spike" : "Normal")