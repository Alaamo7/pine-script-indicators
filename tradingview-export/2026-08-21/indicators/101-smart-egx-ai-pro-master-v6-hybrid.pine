//@version=6
// مؤشر: Smart EGX AI Pro Master v6 - Hybrid (Scalp + Swing)
// المبرمج: خبير Pine Script Senior
// موجه إلى: علاء - تم إصلاح تحذيرات ta.crossover لضمان دقة الإشارات
indicator("Smart EGX AI Pro Master v6 - Hybrid", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200)

//====================================================
// 1) المدخلات (Inputs)
//====================================================
groupMode    = "إعدادات التشغيل"
enableScalp  = input.bool(true, "تفعيل إشارات السكالبينج (لزيادة الصفقات)", group=groupMode)
enableSwing  = input.bool(true, "تفعيل إشارات السوينج (الاستثمار)", group=groupMode)
barsSession  = input.int(24, "شموع الجلسة (EGX Pack)", group=groupMode)

groupScalp   = "إعدادات السكالبينج السريع"
fastEMA      = input.int(9, "EMA سريع", group=groupScalp)
midEMA       = input.int(21, "EMA وسيط", group=groupScalp)
rsiFastLen   = input.int(7, "RSI سريع (للسكالبينج)", group=groupScalp)

groupSMC     = "منطق المؤسسات والسيولة"
volSpikeMult = input.float(1.5, "حجم تداول مؤسسي (سبايك)", group=groupSMC)
pivLen       = input.int(3, "طول الـ Pivot", group=groupSMC)

groupVisual  = "الواجهة والداشبورد"
mobileMode   = input.bool(false, "وضع الموبايل", group=groupVisual)

//====================================================
// 2) محرك الاتجاه (Trend Engine)
//====================================================
f_len(x) => math.min(math.max(x, 1), 4999)

ema9   = ta.ema(close, fastEMA)
ema21  = ta.ema(close, midEMA)
ema144 = ta.ema(close, f_len(math.round(144 * barsSession)))
ema288 = ta.ema(close, f_len(math.round(288 * barsSession)))
vwap   = ta.vwap(hlc3)

// رسم المتوسطات
plot(ema9,  "EMA 9",  color=color.aqua, linewidth=1)
plot(ema21, "EMA 21", color=color.blue, linewidth=1)
plot(ema144, "EMA 144", color=color.fuchsia, linewidth=2)
plot(ema288, "EMA 288", color=color.gray, linewidth=3)
plot(vwap, "VWAP", color=color.yellow, linewidth=2)

//====================================================
// 3) التحليل الفني ونظام التقييم (Score System)
//====================================================
rsi = ta.rsi(close, rsiFastLen)
volMA = ta.sma(volume, 20)
isVolSpike = volume > volMA * volSpikeMult

// حساب نقاط السكالبينج
int scalpScore = 0
scalpScore += ta.crossover(ema9, ema21) ? 3 : 0
scalpScore += (close > vwap) ? 1 : -1
scalpScore += (rsi > 50) ? 1 : 0
scalpScore += isVolSpike ? 2 : 0

// حساب نقاط السوينج
int swingScore = 0
swingScore += (close > ema144) ? 2 : -2
swingScore += (close > ema288) ? 3 : -3

//====================================================
// 4) محرك الإشارات (Signal Engine) - معالجة التحذير
//====================================================
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var float lastSH = na
var float lastSL = na

if not na(ph)
    lastSH := ph
if not na(pl)
    lastSL := pl

// الحل: حساب التقاطعات خارج جملة الشرط لتعمل على كل شمعة
swingCrossUp   = ta.crossover(close, lastSH)
swingCrossDown = ta.crossunder(close, lastSL)

// دمج النتائج الآن في شروط الإشارة النهائية
scalpBuy  = enableScalp and scalpScore >= 4 and close > ema21
scalpSell = enableScalp and scalpScore <= -3 and close < ema21

swingBuy  = enableSwing and swingScore >= 5 and swingCrossUp
swingSell = enableSwing and swingScore <= -5 and swingCrossDown

// رسم الإشارات برمز صغيرة لتقليل الزحمة طبقاً لفلسفتنا
plotshape(scalpBuy and not swingBuy, "Scalp Buy", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 30), size=size.tiny)
plotshape(swingBuy, "Swing Buy", style=shape.labelup, location=location.belowbar, color=color.lime, text="SWING", textcolor=color.black, size=size.small)
plotshape(scalpSell and not swingSell, "Scalp Sell", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 30), size=size.tiny)
plotshape(swingSell, "Swing Sell", style=shape.labeldown, location=location.abovebar, color=color.red, text="SWING", textcolor=color.white, size=size.small)

//====================================================
// 5) الداشبورد التفسيري (Educational Dashboard)
//====================================================
var table dash = table.new(position.middle_right, 2, 8, border_width=1, frame_color=color.gray, bgcolor=color.new(color.black, 20))

txtSize = mobileMode ? size.tiny : size.small

if barstate.islast
    table.cell(dash, 0, 0, "البند", bgcolor=color.blue, text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 0, "الحالة", bgcolor=color.blue, text_color=color.white, text_size=txtSize)
    
    table.cell(dash, 0, 1, "المضاربة (Scalp)", text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 1, scalpScore >= 4 ? "فرصة نشطة ↗" : "انتظار", text_color=scalpScore >= 4 ? color.lime : color.silver, text_size=txtSize)

    table.cell(dash, 0, 2, "الاستثمار (Swing)", text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 2, swingScore >= 5 ? "إيجابي قوي" : (swingScore <= -5 ? "سلبي/خروج" : "تذبذب"), text_color=swingScore >= 5 ? color.lime : (swingScore <= -5 ? color.red : color.yellow), text_size=txtSize)

    table.cell(dash, 0, 3, "السيولة (Volume)", text_color=color.white, text_size=txtSize)
    table.cell(dash, 1, 3, isVolSpike ? "دخول مؤسسي ≋" : "طبيعية", text_color=isVolSpike ? color.aqua : color.silver, text_size=txtSize)

    table.cell(dash, 0, 4, "دليل الشارت", text_color=color.black, bgcolor=color.yellow, text_size=txtSize)
    table.cell(dash, 1, 4, "▲: سكالبينج | SWING: استثمار", text_color=color.black, bgcolor=color.yellow, text_size=txtSize)