//@version=6
indicator("Expert EGX Analyst Pro v3", overlay=true)

//==============================
// SETTINGS
//==============================

groupCore = "Core Settings"

showMA = input.bool(true,"Show Moving Averages",group=groupCore)
showDashboard = input.bool(true,"Show Dashboard",group=groupCore)
showSignals = input.bool(true,"Show Smart Signals",group=groupCore)

//==============================
// MOVING AVERAGES
//==============================

ema13 = ta.ema(close,13)
ema30 = ta.ema(close,30)
ema72 = ta.ema(close,72)
ema144 = ta.ema(close,144)
ema288 = ta.ema(close,288)

plot(showMA ? ema13 : na,"EMA13",color=color.orange)
plot(showMA ? ema30 : na,"EMA30",color=color.blue)
plot(showMA ? ema72 : na,"EMA72",color=color.aqua)
plot(showMA ? ema144 : na,"EMA144",color=color.purple)
plot(showMA ? ema288 : na,"EMA288",color=color.gray)

//==============================
// VWAP
//==============================

vwap = ta.vwap
plot(showMA ? vwap : na,"VWAP",color=color.yellow)

//==============================
// RSI + ADX
//==============================

rsi = ta.rsi(close,14)

[plusDI,minusDI,adx] = ta.dmi(14,14)

//==============================
// TREND DETECTION
//==============================

trend =
 close > ema13 and close > ema30 ? "Bullish" :
 close < ema13 and close < ema30 ? "Bearish" :
 "Sideways"

//==============================
// LIQUIDITY ZONES
//==============================

pivotHigh = ta.pivothigh(high,3,3)
pivotLow = ta.pivotlow(low,3,3)

if showSignals and not na(pivotHigh)
    label.new(bar_index,high,"Liquidity High",
    style=label.style_label_down,
    color=color.red,
    textcolor=color.white)

if showSignals and not na(pivotLow)
    label.new(bar_index,low,"Liquidity Low",
    style=label.style_label_up,
    color=color.green,
    textcolor=color.white)

//==============================
// ORDER BLOCK DETECTOR
//==============================

bullishOB =
 close > open and
 close[1] < open[1] and
 close > high[1]

bearishOB =
 close < open and
 close[1] > open[1] and
 close < low[1]

if showSignals and bullishOB
    label.new(bar_index,low,"Bull OB",
    style=label.style_label_up,
    color=color.green,
    textcolor=color.white)

if showSignals and bearishOB
    label.new(bar_index,high,"Bear OB",
    style=label.style_label_down,
    color=color.red,
    textcolor=color.white)

//==============================
// LIQUIDITY SWEEP
//==============================

sweepHigh =
 high > high[1] and close < high[1]

sweepLow =
 low < low[1] and close > low[1]

if showSignals and sweepHigh
    label.new(bar_index,high,"Sweep",
    style=label.style_label_down,
    color=color.orange)

if showSignals and sweepLow
    label.new(bar_index,low,"Sweep",
    style=label.style_label_up,
    color=color.aqua)

//==============================
// MTF TREND
//==============================

htf = request.security(syminfo.tickerid,"60",close)

htfTrend =
 htf > ta.ema(htf,50) ? "Bull" : "Bear"

//==============================
// DASHBOARD
//==============================

var table dashboard = table.new(position.top_right,2,6,border_width=1)

if showDashboard and barstate.islast

    table.cell(dashboard,0,0,"Trend")
    table.cell(dashboard,1,0,trend)

    table.cell(dashboard,0,1,"HTF Trend")
    table.cell(dashboard,1,1,htfTrend)

    table.cell(dashboard,0,2,"RSI")
    table.cell(dashboard,1,2,str.tostring(rsi))

    table.cell(dashboard,0,3,"ADX")
    table.cell(dashboard,1,3,str.tostring(adx))

    table.cell(dashboard,0,4,"Price")
    table.cell(dashboard,1,4,str.tostring(close))

    table.cell(dashboard,0,5,"Volume")
    table.cell(dashboard,1,5,str.tostring(volume))