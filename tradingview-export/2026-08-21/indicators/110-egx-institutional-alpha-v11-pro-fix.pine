//@version=6
// @description مؤشر علاء المؤسسي المطور - نسخة مصححة v11 لأسهم البورصة المصرية
// @author Senior Pine Programmer
indicator("EGX Institutional Alpha v11 - Pro Fix", overlay=true, max_lines_count=500, max_labels_count=500)

// ==========================================
// 1. إعدادات المدخلات (Inputs)
// ==========================================
groupTrend = "محرك الاتجاه (Trend)"
emaFastLen = input.int(50, "المتوسط السريع (EMA 50)", minval=1, group=groupTrend)
emaSlowLen = input.int(200, "المتوسط البطيء (EMA 200)", minval=1, group=groupTrend)

groupSMC = "هيكل السوق المؤسسي (SMC)"
pivotLen = input.int(3, "قوة القمم والقيعان (Pivot)", minval=2, group=groupSMC)

groupUI = "واجهة المستخدم (الداشبورد)"
dashPos = input.string("Middle Right", "موقع اللوحة", options=["Top Right", "Middle Right", "Bottom Right"], group=groupUI)

// ==========================================
// 2. محرك الاتجاه (Trend Engine)
// ==========================================
ema50  = ta.ema(close, emaFastLen)
ema200 = ta.ema(close, emaSlowLen)

// تحديد الاتجاه العام (مثال: سهم EFIH فوق EMA 200)
isBullishTrend = close > ema50 and ema50 > ema200
isBearishTrend = close < ema50 and ema50 < ema200

plot(ema50,  "EMA 50",  color=color.new(color.blue, 50), linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.red, 30),  linewidth=3)

// ==========================================
// 3. المؤشرات الفنية (Technical Indicators)
// ==========================================
rsiValue = ta.rsi(close, 14)

// ==========================================
// 4. السيولة والفوليوم (Volume & Liquidity)
// ==========================================
volMA      = ta.sma(volume, 20)
isVolSpike = volume > volMA * 1.5 // كشف دخول "المال الذكي" (Smart Money)

// ==========================================
// 5. منطق SMC (SMC Logic) - Non-Repainting
// ==========================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastHigh = na
var float lastLow  = na

if not na(ph)
    lastHigh := ph

if not na(pl)
    lastLow := pl

// كسر الهيكل (BOS) بناءً على إغلاق شمعة مؤكد
bool bosUp   = close > lastHigh and close[1] <= lastHigh
bool bosDown = close < lastLow and close[1] >= lastLow

// ==========================================
// 6. نظام النقاط الذكي (Score System)
// ==========================================
int score = 0
score += (isBullishTrend ? 2 : isBearishTrend ? -2 : 0) // الاتجاه
score += (rsiValue > 50  ? 1 : -1)                      // الزخم
score += (bosUp          ? 2 : bosDown        ? -2 : 0) // الهيكلية
score += (isVolSpike     ? 1 : 0)                       // السيولة

// ==========================================
// 7. محرك الإشارات (Signal Engine)
// ==========================================
bool buySignal  = score >= 4 and close > open
bool sellSignal = score <= -4 and close < open

// ==========================================
// 8. الداشبورد والدليل (Dashboard / Legend) - (تم تصحيح الأخطاء البرمجية هنا)
// ==========================================
var table dash = table.new(dashPos == "Top Right" ? position.top_right : dashPos == "Middle Right" ? position.middle_right : position.bottom_right, 2, 10, border_width=1, border_color=color.gray)

if barstate.islast
    // ترويسة اللوحة
    table.cell(dash, 0, 0, "البند الفني",  text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 0, syminfo.ticker, text_color=color.yellow, bgcolor=color.black)
    
    // حالة الاتجاه
    table.cell(dash, 0, 1, "الاتجاه العام", text_color=color.white, bgcolor=color.rgb(30, 30, 30))
    table.cell(dash, 1, 1, isBullishTrend ? "صعود مؤسسي" : isBearishTrend ? "هبوط مؤسسي" : "عرضي", 
               text_color=color.white, 
               bgcolor=isBullishTrend ? color.new(color.green, 50) : isBearishTrend ? color.new(color.red, 50) : color.gray)
    
    // قوة السكور
    table.cell(dash, 0, 2, "السكور الإجمالي", text_color=color.white, bgcolor=color.rgb(30, 30, 30))
    table.cell(dash, 1, 2, str.tostring(score), 
               text_color=color.white, 
               bgcolor=score >= 3 ? color.green : score <= -3 ? color.red : color.orange)

    // دليل الرموز (Legend) كما طلبت يا علاء
    table.cell(dash, 0, 3, "--- دليل المرجعية ---", text_color=color.aqua, bgcolor=color.black)
    table.merge_cells(dash, 0, 3, 1, 3)
    
    table.cell(dash, 0, 4, "المثلث ▲", text_color=color.green, bgcolor=color.rgb(20, 25, 35))
    table.cell(dash, 1, 4, "تجميع سيولة (Buy)", text_color=color.white, bgcolor=color.rgb(20, 25, 35))
    
    table.cell(dash, 0, 5, "المثلث ▼", text_color=color.red, bgcolor=color.rgb(20, 25, 35))
    table.cell(dash, 1, 5, "تصريف سيولة (Sell)", text_color=color.white, bgcolor=color.rgb(20, 25, 35))

    // التوصية النهائية (تصحيح الخطأ المنطقي في جملة Ternary)
    string finalRec = score >= 4 ? "فرصة شراء" : score <= -4 ? "تخفيف مراكز" : "مراقبة وانتظار"
    color recCol = score >= 4 ? color.green : score <= -4 ? color.red : color.orange
    
    table.cell(dash, 0, 8, "القرار الفني", text_color=color.yellow, bgcolor=color.black)
    table.cell(dash, 1, 8, finalRec, text_color=color.white, bgcolor=recCol)

// ==========================================
// 9. الطبقة البصرية (Visual Layer)
// ==========================================
// رسم الإشارات كعلامات هندسية نظيفة فقط
plotshape(buySignal,  "Buy Symbol",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(sellSignal, "Sell Symbol", shape.triangledown, location.abovebar, color.red,   size=size.small)

// تلوين البارات عند حدوث طفرة سيولة
barcolor(isVolSpike ? color.orange : na)

// ==========================================
// 10. التنبيهات (Alerts)
// ==========================================
alertcondition(buySignal,  "إشارة شراء مؤسسية", "دخول ذكي على سهم {{ticker}} بسكور {{score}}")
alertcondition(sellSignal, "إشارة بيع مؤسسية", "خروج ذكي على سهم {{ticker}} بسكور {{score}}")