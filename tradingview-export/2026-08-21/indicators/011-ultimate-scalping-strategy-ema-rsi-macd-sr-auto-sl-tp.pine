//@version=6
indicator("Ultimate Scalping Strategy - EMA + RSI + MACD + SR + Auto SL/TP", overlay=true)

// إعدادات المتوسطات
emaShortLength = input.int(9, title="EMA القصير (9)")
emaLongLength  = input.int(21, title="EMA الطويل (21)")

emaShort = ta.ema(close, emaShortLength)
emaLong = ta.ema(close, emaLongLength)

plot(emaShort, title="EMA 9", color=color.blue)
plot(emaLong, title="EMA 21", color=color.orange)

// إعدادات RSI
rsiLength = input.int(14, title="طول RSI")
rsiSource = input.source(close, title="مصدر RSI")
rsiOverbought = input.int(70, title="مستوى تشبع شراء RSI")
rsiOversold = input.int(30, title="مستوى تشبع بيع RSI")
rsi = ta.rsi(rsiSource, rsiLength)

// إعدادات MACD
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)

// دعم ومقاومة أوتوماتيكي (قريب جدًا وبسيط)
pivotHigh = ta.pivothigh(high, 5, 5)
pivotLow = ta.pivotlow(low, 5, 5)

var float resistance = na
var float support = na

if (not na(pivotHigh))
    resistance := high[5]
if (not na(pivotLow))
    support := low[5]

plot(resistance, title="مقاومة", color=color.red, style=plot.style_stepline)
plot(support, title="دعم", color=color.green, style=plot.style_stepline)

// شروط الشراء والبيع
buyCondition = ta.crossover(emaShort, emaLong) and rsi < rsiOverbought and macdLine > signalLine
sellCondition = ta.crossunder(emaShort, emaLong) and rsi > rsiOversold and macdLine < signalLine

plotshape(buyCondition, title="إشارة شراء", location=location.belowbar, color=color.green, style=shape.labelup, text="BUY", size=size.small)
plotshape(sellCondition, title="إشارة بيع", location=location.abovebar, color=color.red, style=shape.labeldown, text="SELL", size=size.small)

// ستوب لوس وتيك بروفيت أوتوماتيك
atrLength = input.int(14, title="طول ATR")
atrMultiplier = input.float(1.5, title="مضاعف ATR لستوب لوس وتيك بروفيت")
atr = ta.atr(atrLength)

var float stopLoss = na
var float takeProfit = na

if (buyCondition)
    stopLoss := close - (atr * atrMultiplier)
    takeProfit := close + (atr * atrMultiplier)
if (sellCondition)
    stopLoss := close + (atr * atrMultiplier)
    takeProfit := close - (atr * atrMultiplier)

plot(stopLoss, title="Stop Loss", color=color.red, style=plot.style_circles)
plot(takeProfit, title="Take Profit", color=color.green, style=plot.style_circles)

// تنبيهات
if (buyCondition)
    alert("إشارة شراء ✅", alert.freq_once_per_bar)

if (sellCondition)
    alert("إشارة بيع ✅", alert.freq_once_per_bar)
