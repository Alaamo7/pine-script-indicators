//@version=6
// @description نسخة احترافية نظيفة للبورصة المصرية - تعتمد على الرموز ودليل قراءة مدمج في الداشبورد
// @author Senior Pine Programmer for Alaa
indicator("EGX Institutional Alpha v7 - Clean", overlay=true, max_lines_count=500, max_labels_count=500)

//====================================================
// 1. Inputs - تنظيم المدخلات
//====================================================
groupTrend   = "إعدادات الاتجاه"
emaFastLen   = input.int(50, "متوسط المدى (EMA 50)", minval=1, group=groupTrend)
emaSlowLen   = input.int(200, "الاتجاه الرئيسي (EMA 200)", minval=1, group=groupTrend)

groupSMC      = "هيكل السوق (SMC)"
pivotLen      = input.int(3, "قوة الـ Pivot", minval=2, group=groupSMC)
showOB        = input.bool(true, "إظهار مناطق الـ Order Blocks", group=groupSMC)

groupDashboard = "الواجهة والداشبورد"
dashPos       = input.string("Middle Right", "موقع اللوحة", options=["Top Right", "Middle Right", "Bottom Right"], group=groupDashboard)

//====================================================
// 2. Trend & Momentum Engine
//====================================================
ema50  = ta.ema(close, emaFastLen)
ema200 = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, 14)

// تحديد الاتجاه العام
isBullishTrend = close > ema50 and ema50 > ema200
isBearishTrend = close < ema50 and ema50 < ema200

plot(ema50, "EMA 50", color=color.new(color.blue, 30), linewidth=2)
plot(ema200, "EMA 200", color=color.new(color.red, 10), linewidth=3)

//====================================================
// 3. Liquidity & SMC Logic (Non-Repainting)
//====================================================
volMA = ta.sma(volume, 20)
isHighVolume = volume > volMA * 1.5

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastHigh = na
var float lastLow  = na
if not na(ph)
    lastHigh := ph
if not na(pl)
    lastLow  := pl

// كسر الهيكل (BOS) مع تأكيد الإغلاق
bool bosUp   = close > lastHigh and close[1] <= lastHigh
bool bosDown = close < lastLow and close[1] >= lastLow

//====================================================
// 4. Score System - نظام النقاط
//====================================================
int score = 0
score += (isBullishTrend ? 1 : isBearishTrend ? -1 : 0)
score += (rsiVal > 55 ? 1 : rsiVal < 45 ? -1 : 0)
score += (ta.mom(close, 10) > 0 ? 1 : -1)
score += (bosUp ? 1 : bosDown ? -1 : 0)
score += (volume > volMA ? 1 : -1)

//====================================================
// 5. Signal Engine - محرك الإشارات (رموز فقط)
//====================================================
bool strongBuy  = score >= 4  and close > open
bool strongSell = score <= -4 and close < open

// استخدام رموز صغيرة بدون نصوص لضمان نظافة الشارت
plotshape(strongBuy,  "Buy",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(strongSell, "Sell", shape.triangledown, location.abovebar, color.red,   size=size.small)

//====================================================
// 6. Professional Dashboard - لوحة البيانات الشاملة
//====================================================
var table dash = table.new(dashPos == "Top Right" ? position.top_right : dashPos == "Middle Right" ? position.middle_right : position.bottom_right, 2, 12, border_width=1, frame_color=color.gray, bgcolor=color.new(color.black, 10))

if barstate.islast
    // --- القسم الأول: حالة السوق ---
    table.cell(dash, 0, 0, "الحالة والقرار", text_color=color.white, bgcolor=color.blue)
    table.cell(dash, 1, 0, "القيمة / التفسير", text_color=color.white, bgcolor=color.blue)
    
    table.cell(dash, 0, 1, "الاتجاه العام", text_color=color.white)
    table.cell(dash, 1, 1, isBullishTrend ? "صاعد مؤسسي" : isBearishTrend ? "هابط مؤسسي" : "عرضي / حذر", bgcolor=isBullishTrend ? color.green : isBearishTrend ? color.red : color.gray)
    
    table.cell(dash, 0, 2, "قوة الإشارة (Score)", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(score), bgcolor=score >= 3 ? color.green : score <= -3 ? color.red : color.orange)

    table.cell(dash, 0, 3, "التوصية التقنية", text_color=color.white)
    table.cell(dash, 1, 3, score >= 4 ? "تجميع / شراء" : score <= -4 ? "تخفيف / بيع" : "مراقبة وانتظار")

    // --- القسم الثاني: دليل الرموز (Legend) ---
    table.cell(dash, 0, 4, "دليل الرموز (شارت)", text_color=color.white, bgcolor=color.rgb(54, 58, 69))
    table.cell(dash, 1, 4, "المعنى الوظيفي", text_color=color.white, bgcolor=color.rgb(54, 58, 69))

    table.cell(dash, 0, 5, "▲ (أخضر)", text_color=color.green)
    table.cell(dash, 1, 5, "تلاقي عوامل شرائية (دخول)")
    
    table.cell(dash, 0, 6, "▼ (أحمر)", text_color=color.red)
    table.cell(dash, 1, 6, "تلاقي عوامل بيعية (خروج)")

    // --- القسم الثالث: دليل الخطوط ---
    table.cell(dash, 0, 7, "دليل الخطوط والألوان", text_color=color.white, bgcolor=color.rgb(54, 58, 69))
    table.cell(dash, 1, 7, "الوصف الفني", text_color=color.white, bgcolor=color.rgb(54, 58, 69))

    table.cell(dash, 0, 8, "خط أزرق سميك", text_color=color.blue)
    table.cell(dash, 1, 8, "متوسط 50: فلتر الاتجاه اللحظي")

    table.cell(dash, 0, 9, "خط أحمر سميك", text_color=color.red)
    table.cell(dash, 1, 9, "متوسط 200: جدار المؤسسات الرئيسي")

    table.cell(dash, 0, 10, "خلفية برتقالية", text_color=color.orange)
    table.cell(dash, 1, 10, "تنبيه سيولة غير طبيعية (Spike)")

//====================================================
// 7. Visual Layer - الإضافات البصرية النظيفة
//====================================================
// تلوين الخلفية فقط عند وجود فوليوم ضخم جداً للتنبيه
bgcolor(isHighVolume ? color.new(color.orange, 90) : na)