//@version=6
// مؤشر: Smart EGX AI Pro Master v7 - SMC Hybrid
// المبرمج: خبير Pine Script Senior
// موجه إلى: علاء - إضافة مناطق السيولة (Order Blocks) لدعم السكالبينج
indicator("Smart EGX AI Pro Master v7 - SMC Hybrid", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200)

//====================================================
// 1) المدخلات (Inputs)
//====================================================
groupMode    = "إعدادات التشغيل"
enableScalp  = input.bool(true, "تفعيل السكالبينج", group=groupMode)
enableSwing  = input.bool(true, "تفعيل السوينج", group=groupMode)
showZones    = input.bool(true, "إظهار مناطق السيولة (OB)", group=groupMode)

groupSMC     = "إعدادات المؤسسات"
obLen        = input.int(5, "قوة منطقة السيولة (Pivot)", group=groupSMC)
extendBars   = input.int(20, "امتداد المنطقة مستقبلاً", group=groupSMC)

//====================================================
// 2) محرك الاتجاه والسيولة (Trend & Volume)
//====================================================
ema9   = ta.ema(close, 9)
ema21  = ta.ema(close, 21)
ema288 = ta.ema(close, 288) // الاتجاه الرئيسي المصري
vwap   = ta.vwap(hlc3)

plot(ema9, "EMA 9", color=color.aqua)
plot(ema21, "EMA 21", color=color.blue)
plot(ema288, "EMA 288", color=color.gray, linewidth=2)
plot(vwap, "VWAP", color=color.yellow, linewidth=2)

//====================================================
// 3) كشف مناطق السيولة (Order Blocks) - بصمة الميكر
//====================================================
// منطقة طلب (Bullish OB): شمعة هابطة تليها حركة صاعدة قوية
bullOB = close > open and close[1] < open[1] and close > high[1] and volume > ta.sma(volume, 20)
// منطقة عرض (Bearish OB): شمعة صاعدة تليها حركة هابطة قوية
bearOB = close < open and close[1] > open[1] and close < low[1] and volume > ta.sma(volume, 20)

// رسم الصناديق آلياً
if showZones and bullOB
    box.new(bar_index-1, high[1], bar_index + extendBars, low[1], bgcolor=color.new(color.lime, 90), border_color=color.lime)
if showZones and bearOB
    box.new(bar_index-1, high[1], bar_index + extendBars, low[1], bgcolor=color.new(color.red, 90), border_color=color.red)

//====================================================
// 4) محرك الإشارات الهجين (Signal Engine)
//====================================================
rsi = ta.rsi(close, 7)
scalpBuy = ta.crossover(ema9, ema21) and close > vwap and rsi > 50
swingBuy = ta.crossover(close, ta.highest(high, 10)) and close > ema288

// رسم الإشارات
plotshape(enableScalp and scalpBuy, "Scalp Buy", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 30), size=size.tiny)
plotshape(enableSwing and swingBuy, "Swing Buy", style=shape.labelup, location=location.belowbar, color=color.lime, text="SWING", textcolor=color.black, size=size.small)

//====================================================
// 5) الداشبورد المطور (Hybrid Dashboard)
//====================================================
var table dash = table.new(position.middle_right, 2, 7, border_width=1, frame_color=color.gray, bgcolor=color.new(color.black, 20))

if barstate.islast
    table.cell(dash, 0, 0, "البند", bgcolor=color.blue, text_color=color.white)
    table.cell(dash, 1, 0, "الحالة", bgcolor=color.blue, text_color=color.white)
    
    // حالة السكالبينج والسوينج
    table.cell(dash, 0, 1, "المضاربة (Scalp)", text_color=color.white)
    table.cell(dash, 1, 1, scalpBuy ? "إشارة دخول ↗" : "انتظار", text_color=scalpBuy ? color.lime : color.silver)

    table.cell(dash, 0, 2, "الاستثمار (Swing)", text_color=color.white)
    table.cell(dash, 1, 2, close > ema288 ? "إيجابي" : "سلبي", text_color=close > ema288 ? color.lime : color.red)

    // كشف السيولة
    table.cell(dash, 0, 3, "مناطق OB", text_color=color.white)
    table.cell(dash, 1, 3, bullOB ? "تكون منطقة طلب" : (bearOB ? "تكون منطقة عرض" : "لا توجد"), text_color=color.yellow)