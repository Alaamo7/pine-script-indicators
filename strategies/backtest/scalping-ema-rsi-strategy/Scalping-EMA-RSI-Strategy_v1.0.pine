//@version=6
strategy("Scalping EMA+RSI Strategy v1.0 - EGX Long Only", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

//====================================================
// Scalping EMA+RSI Strategy v1.0
// Status: Backtest / Long Only
// Purpose: EGX-friendly long-only scalping strategy using EMA crossover, RSI, and optional ATR risk management.
//====================================================

//====================
// SETTINGS
//====================
groupCore = "Core Settings"
groupRisk = "Risk Management"
groupVis  = "Visual Settings"

emaFastLen = input.int(9, "Fast EMA", minval=1, group=groupCore)
emaSlowLen = input.int(21, "Slow EMA", minval=1, group=groupCore)
rsiLen     = input.int(14, "RSI Length", minval=1, group=groupCore)
rsiEntry   = input.float(50.0, "RSI Entry Threshold", minval=1.0, maxval=99.0, step=0.5, group=groupCore)
rsiExit    = input.float(45.0, "RSI Weakness Exit Threshold", minval=1.0, maxval=99.0, step=0.5, group=groupCore)

useATRExit = input.bool(true, "Use ATR Stop/Target", group=groupRisk)
atrLen     = input.int(14, "ATR Length", minval=1, group=groupRisk)
atrStop    = input.float(1.5, "ATR Stop Multiplier", minval=0.1, step=0.1, group=groupRisk)
atrTarget  = input.float(2.0, "ATR Target Multiplier", minval=0.1, step=0.1, group=groupRisk)

showSignals = input.bool(true, "Show Entry/Exit Signals", group=groupVis)
showMAs      = input.bool(true, "Show EMAs", group=groupVis)

//====================
// CALCULATIONS
//====================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

trendBull = emaFast > emaSlow
trendWeak = emaFast < emaSlow

longCondition = ta.crossover(emaFast, emaSlow) and rsi > rsiEntry
exitCondition = ta.crossunder(emaFast, emaSlow) or rsi < rsiExit

//====================
// ORDERS - EGX LONG ONLY
//====================
if longCondition
    strategy.entry("Long", strategy.long)

if exitCondition
    strategy.close("Long", comment="Trend/RSI Exit")

if useATRExit and strategy.position_size > 0
    longStop = strategy.position_avg_price - atr * atrStop
    longTarget = strategy.position_avg_price + atr * atrTarget
    strategy.exit("ATR TP/SL", "Long", stop=longStop, limit=longTarget)

//====================
// VISUALS
//====================
plot(showMAs ? emaFast : na, title="Fast EMA", color=color.blue, linewidth=2)
plot(showMAs ? emaSlow : na, title="Slow EMA", color=color.red, linewidth=2)

plotshape(showSignals and longCondition, title="Long Entry", location=location.belowbar, style=shape.labelup, color=color.green, text="LONG", textcolor=color.white, size=size.small)
plotshape(showSignals and exitCondition, title="Exit", location=location.abovebar, style=shape.labeldown, color=color.orange, text="EXIT", textcolor=color.black, size=size.tiny)

bgcolor(trendBull ? color.new(color.green, 92) : trendWeak ? color.new(color.red, 94) : na)

//====================
// DASHBOARD
//====================
var table dash = table.new(position.top_right, 2, 5, border_width=1)

if barstate.islast
    table.clear(dash, 0, 0)
    table.cell(dash, 0, 0, "EMA+RSI Strategy", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 1, 0, "Long Only", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 0, 1, "Trend")
    table.cell(dash, 1, 1, trendBull ? "Bullish" : trendWeak ? "Weak" : "Neutral")
    table.cell(dash, 0, 2, "RSI")
    table.cell(dash, 1, 2, str.tostring(rsi, "#.##"))
    table.cell(dash, 0, 3, "ATR")
    table.cell(dash, 1, 3, str.tostring(atr, "#.##"))
    table.cell(dash, 0, 4, "Position")
    table.cell(dash, 1, 4, strategy.position_size > 0 ? "Long" : "Flat")

//====================
// ALERTS
//====================
alertcondition(longCondition, title="EMA RSI Long Entry", message="Scalping EMA+RSI Strategy: Long entry condition detected.")
alertcondition(exitCondition, title="EMA RSI Exit", message="Scalping EMA+RSI Strategy: Exit condition detected.")
